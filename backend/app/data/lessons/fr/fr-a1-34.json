        { "id": "fra1-34-q6", "type": "quiz_choice", "question": "¿Cómo se dice 'Hay sol' (está soleado)?", "options": ["Il y a du soleil", "Il fait soleil", "Le soleil est beau", "Il pleut du soleil"], "correct_answer": "Il y a du soleil", "explanation": "Il y a du soleil = Hay sol." },
        { "id": "fra1-34-q7", "type": "quiz_choice", "question": "¿Qué significa 'Il neige'?", "options": ["Nieva", "Llueve", "Hace viento", "Hace mal tiempo"], "correct_answer": "Nieva", "explanation": "Il neige = Nieva." },
        { "id": "fra1-34-q8", "type": "quiz_choice", "question": "¿Qué significa 'Il fait mauvais'?", "options": ["Hace mal tiempo", "Hace frío", "Hace viento", "Llueve mucho"], "correct_answer": "Hace mal tiempo", "explanation": "Il fait mauvais = Hace mal tiempo." },
