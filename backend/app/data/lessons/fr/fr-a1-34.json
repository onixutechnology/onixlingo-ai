        { "id": "fra1-34-q2", "type": "quiz_choice", "question": "¿Qué significa 'Il fait beau'?", "options": ["Hace buen tiempo", "Hace calor", "Hace frío", "Llueve"], "correct_answer": "Hace buen tiempo", "explanation": "Il fait beau = Hace buen tiempo (día hermoso)." },
        { "id": "fra1-34-q3", "type": "quiz_choice", "question": "¿Cómo se dice 'Hace calor'?", "options": ["Il fait chaud", "Il fait froid", "Il fait beau", "Il y a du soleil"], "correct_answer": "Il fait chaud", "explanation": "Il fait chaud = Hace calor." },
        { "id": "fra1-34-q4", "type": "quiz_choice", "question": "¿Qué significa 'Il pleut'?", "options": ["Llueve", "Nieva", "Hace viento", "Hace calor"], "correct_answer": "Llueve", "explanation": "Il pleut = Llueve / Está lloviendo." },
