      "title": "The Final A1 Exam",
      "description": "El desafío definitivo. 25 preguntas para demostrar que dominas el A1.",
      "questions": [
        { "id": "fra1-40-q1", "type": "quiz_choice", "question": "¿Cómo se dice 'Yo tengo 20 años'?", "options": ["J'ai 20 ans", "Je suis 20 ans", "J'ai 20 années", "Je suis 20 années"], "correct_answer": "J'ai 20 ans", "explanation": "En francés la edad se tiene, no se es: J'ai 20 ans." },
        { "id": "fra1-40-q2", "type": "quiz_choice", "question": "¿Cuál es la forma correcta para 'Ellos son'?", "options": ["Ils sont", "Ils ont", "Ils vont", "Ils font"], "correct_answer": "Ils sont", "explanation": "Verbo Être: Ils sont." },
        { "id": "fra1-40-q3", "type": "quiz_choice", "question": "¿Cómo se dice 'Él va a comer' (Futuro próximo)?", "options": ["Il va manger", "Il va à manger", "Il veut manger", "Il a mangé"], "correct_answer": "Il va manger", "explanation": "Aller + Infinitivo (sin à): Il va manger." },
        { "id": "fra1-40-q4", "type": "quiz_choice", "question": "¿Qué partitivo usas en: 'Je bois ____ eau'?", "options": ["de l'", "du", "de la", "des"], "correct_answer": "de l'", "explanation": "Empieza por vocal: de l'eau." },
        { "id": "fra1-40-q5", "type": "quiz_choice", "question": "¿Cómo se dice 'Nosotros hablamos'?", "options": ["Nous parlons", "Nous parlez", "Nous parlent", "Nous parle"], "correct_answer": "Nous parlons", "explanation": "Verbo en -ER con Nous: terminación -ons." },
        { "id": "fra1-40-q6", "type": "quiz_choice", "question": "¿Qué significa 'Je veux'?", "options": ["Yo quiero", "Yo puedo", "Yo voy", "Yo veo"], "correct_answer": "Yo quiero", "explanation": "Vouloir = Je veux." },
        { "id": "fra1-40-q7", "type": "quiz_choice", "question": "Completa: Tu vas ____ cinéma. (Voy al cine).", "options": ["au", "à la", "à le", "aux"], "correct_answer": "au", "explanation": "Cinéma es masculino: à + le = au." },
        { "id": "fra1-40-q8", "type": "quiz_choice", "question": "¿Cómo se dice 'Yo hablé' (Pasado compuesto)?", "options": ["J'ai parlé", "Je parle", "J'ai parler", "Je suis parlé"], "correct_answer": "J'ai parlé", "explanation": "Avoir + Participio: J'ai parlé." },
        { "id": "fra1-40-q9", "type": "quiz_choice", "question": "¿Cómo se dice 'Mi madre'?", "options": ["Ma mère", "Mon mère", "Mes mère", "Sa mère"], "correct_answer": "Ma mère", "explanation": "Mère es femenino: Ma mère." },
        { "id": "fra1-40-q10", "type": "quiz_choice", "question": "¿Qué significa 'Il fait beau'?", "options": ["Hace buen tiempo", "Hace frío", "Llueve", "Hace viento"], "correct_answer": "Hace buen tiempo", "explanation": "Il fait beau = Hace buen tiempo." },
        { "id": "fra1-40-q11", "type": "quiz_choice", "question": "¿Cómo pides la cuenta en un restaurante?", "options": ["L'addition, s'il vous plaît", "Le menu, s'il vous plaît", "La carte, s'il vous plaît", "La table, s'il vous plaît"], "correct_answer": "L'addition, s'il vous plaît", "explanation": "La cuenta = L'addition." },
        { "id": "fra1-40-q12", "type": "quiz_choice", "question": "¿Cuál es la respuesta a 'Comment ça va ?' (¿Cómo estás?)", "options": ["Ça va bien", "Je m'appelle", "J'ai faim", "Je suis un homme"], "correct_answer": "Ça va bien", "explanation": "Ça va bien = Estoy bien." },
        { "id": "fra1-40-q13", "type": "quiz_choice", "question": "¿Cómo se dice 'La casa'?", "options": ["La maison", "Le salon", "La chambre", "La cuisine"], "correct_answer": "La maison", "explanation": "La casa = La maison." },
        { "id": "fra1-40-q14", "type": "quiz_choice", "question": "¿Cómo se dice 'En mi casa'?", "options": ["Chez moi", "Dans moi", "À ma maison", "En moi"], "correct_answer": "Chez moi", "explanation": "En mi hogar/casa = Chez moi." },
        { "id": "fra1-40-q15", "type": "quiz_choice", "question": "Completa: Il ____ (Él puede).", "options": ["peut", "peux", "veut", "pouvez"], "correct_answer": "peut", "explanation": "Pouvoir para Il = peut." },
        { "id": "fra1-40-q16", "type": "quiz_choice", "question": "Je vais ____ France ____ avion.", "options": ["en / en", "à / en", "en / à", "au / en"], "correct_answer": "en / en", "explanation": "En France (país fem.) y en avion (vehículo cerrado)." },
        { "id": "fra1-40-q17", "type": "quiz_choice", "question": "Completa: Ils ____ (Ellos tienen).", "options": ["ont", "sont", "vont", "font"], "correct_answer": "ont", "explanation": "Verbo Avoir para Ils = ont." },
        { "id": "fra1-40-q18", "type": "quiz_choice", "question": "¿Qué pronombre usa el verbo 'se doucher' con Yo? (Je ____ douche).", "options": ["me", "te", "se", "m'"], "correct_answer": "me", "explanation": "Je me douche." },
        { "id": "fra1-40-q19", "type": "quiz_choice", "question": "¿Cómo se dice 'Son las 8 y media'?", "options": ["Il est huit heures et demie", "Il est huit heures demi", "C'est huit heures demie", "Il est huit demie"], "correct_answer": "Il est huit heures et demie", "explanation": "et demie = y media." },
        { "id": "fra1-40-q20", "type": "quiz_choice", "question": "¿Qué significa 'Le fromage'?", "options": ["El queso", "El pan", "El pollo", "El pescado"], "correct_answer": "El queso", "explanation": "Le fromage = El queso." },
        { "id": "fra1-40-q21", "type": "quiz_choice", "question": "¿Cómo se dice 'El pantalón'?", "options": ["Le pantalon", "Les pantalons", "La jupe", "La chemise"], "correct_answer": "Le pantalon", "explanation": "Es singular en francés: Le pantalon." },
        { "id": "fra1-40-q22", "type": "quiz_choice", "question": "¿Qué verbo es 'Être'?", "options": ["Ser / Estar", "Tener / Haber", "Ir", "Poder"], "correct_answer": "Ser / Estar", "explanation": "Être = Ser / Estar." },
        { "id": "fra1-40-q23", "type": "quiz_choice", "question": "Completa: Vous ____ (Ustedes son).", "options": ["êtes", "avez", "allez", "faites"], "correct_answer": "êtes", "explanation": "Verbo Être para Vous = êtes." },
        { "id": "fra1-40-q24", "type": "quiz_choice", "question": "¿Qué significa 'Ils parlent'?", "options": ["Ellos hablan", "Él habla", "Nosotros hablamos", "Ustedes hablan"], "correct_answer": "Ellos hablan", "explanation": "Ils parlent = Ellos hablan." },
        { "id": "fra1-40-q25", "type": "quiz_choice", "question": "¿Cuál es la regla de oro para la pronunciación de verbos terminados en '-ent' (Ej: parlent)?", "options": ["Son completamente mudos", "Se pronuncian como 'on'", "Se pronuncian como 'an'", "Se dice la T fuerte"], "correct_answer": "Son completamente mudos", "explanation": "La terminación '-ent' en los verbos nunca se pronuncia." }
      ]
