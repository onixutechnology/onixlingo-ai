        { "id": "fra1-20-q16", "type": "quiz_choice", "question": "¿Cómo se dice 'Una robe naranja' (un vestido naranja)?", "options": ["Une robe orange", "Une robe orangée", "Un robe orange", "Une orange robe"], "correct_answer": "Une robe orange", "explanation": "Orange es invariable y va después del sustantivo." },
