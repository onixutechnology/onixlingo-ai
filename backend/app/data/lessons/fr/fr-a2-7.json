        {
          "type": "quiz_choice",
          "question": "¿Cómo se dice 'Aló / Hola' al contestar el teléfono?",
          "options": [
            "Allô",
            "Bonjour",
            "Merci"
          ],
          "correct_answer": "Allô",
          "explanation": "Allô es la palabra estándar para contestar llamadas."
        },
        {
          "type": "quiz_choice",
          "question": "Traduce 'No cuelgue por favor':",
          "options": [
            "Ne quittez pas s'il vous plaît",
