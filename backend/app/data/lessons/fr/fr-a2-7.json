      "title": "Atender Llamadas Telefónicas",
      "parts": [
        {
          "visual": "Atender de forma corporativa: \"Allô, bonjour. Ici Pierre de chez OnixU.\"",
          "audio": "Allô bonjour. Ici Pierre de chez OnixU."
        },
        {
          "visual": "Solicitar que espere al teléfono: \"Ne quittez pas s'il vous plaît\" (No cuelgue, por favor).",
          "audio": "Ne quittez pas s'il vous plaît."
        },
        {
          "visual": "Transferir una llamada: \"Je vous passe le manager\" (Le paso al gerente).",
          "audio": "Je vous passe le manager de projet."
        },
        {
          "visual": "Tomar recados: \"Je prends un message\" (Tomo un mensaje).",
          "audio": "Je prends un message pour mon collègue."
        },
        {
          "visual": "Confirmar recepción: \"C'est noté, merci\" (Queda anotado, gracias).",
          "audio": "C'est bien noté, merci pour votre appel."
        }
      ]
    },
