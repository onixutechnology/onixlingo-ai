        { "id": "fra2-5-q1", "type": "quiz_choice", "question": "¿Cómo se dice 'Me despierto a las 8'?", "options": ["Je me réveille à 8 heures", "Je se réveille à 8 heures", "Je réveille à 8 heures", "Je me lève à 8 heures"], "correct_answer": "Je me réveille à 8 heures", "explanation": "Reflexivo 'me' + verbo réveiller (despertar)." },
        { "id": "fra2-5-q2", "type": "quiz_choice", "question": "Completa con el pronombre correcto: Nous ____ douchons.", "options": ["nous", "vous", "se", "me"], "correct_answer": "nous", "explanation": "Para 'Nous', el pronombre reflexivo es 'nous'." },
        { "id": "fra2-5-q3", "type": "quiz_choice", "question": "¿Cuál es el participio pasado de 'Faire' (Hacer)?", "options": ["Fait", "Faire", "Faisé", "Fini"], "correct_answer": "Fait", "explanation": "Faire -> Fait." },
        { "id": "fra2-5-q4", "type": "quiz_choice", "question": "¿Cómo se dice 'Yo he comido' o 'Yo comí'?", "options": ["J'ai mangé", "Je mangé", "Je suis mangé", "J'avais manger"], "correct_answer": "J'ai mangé", "explanation": "Auxiliar Avoir (J'ai) + Participio (mangé)." },
        { "id": "fra2-5-q5", "type": "quiz_choice", "question": "¿Qué verbo auxiliar usan los verbos de movimiento (Aller, Venir, Arriver) en el Passé Composé?", "options": ["Être", "Avoir", "Faire", "Aller"], "correct_answer": "Être", "explanation": "Los verbos de movimiento forman 'La casa de Être'." },
        { "id": "fra2-5-q6", "type": "quiz_choice", "question": "¿Cómo dice una chica 'Yo fui / Yo he ido'?", "options": ["Je suis allée", "Je suis allé", "J'ai allée", "J'ai allé"], "correct_answer": "Je suis allée", "explanation": "Être exige concordancia. Como es chica, se añade una 'e'." },
        { "id": "fra2-5-q7", "type": "quiz_choice", "question": "Il voyage ____ avion.", "options": ["en", "à", "dans", "au"], "correct_answer": "en", "explanation": "Avión es transporte cerrado, usa 'en'." },
        { "id": "fra2-5-q8", "type": "quiz_choice", "question": "Je vais au travail ____ vélo.", "options": ["à", "en", "sur", "dans"], "correct_answer": "à", "explanation": "Bicicleta es transporte abierto, usa 'à'." },
        { "id": "fra2-5-q9", "type": "quiz_choice", "question": "¿Cómo se dice 'Todo recto' o 'Derecho'?", "options": ["Tout droit", "À droite", "À gauche", "Tout droite"], "correct_answer": "Tout droit", "explanation": "Todo recto = Tout droit." },
        { "id": "fra2-5-q10", "type": "quiz_choice", "question": "Completa: Ils ____ allés au cinéma. (Ellos fueron al cine).", "options": ["sont", "ont", "vont", "font"], "correct_answer": "sont", "explanation": "Aller usa Être. Être para 'Ils' es 'sont'." },
        { "id": "fra2-5-q11", "type": "quiz_choice", "question": "¿Cuál es el participio pasado del verbo 'Prendre'?", "options": ["Pris", "Prendu", "Prendé", "Prit"], "correct_answer": "Pris", "explanation": "Prendre -> Pris." },
        { "id": "fra2-5-q12", "type": "quiz_choice", "question": "¿Cómo se dice 'Ayer'?", "options": ["Hier", "Demain", "Aujourd'hui", "Le matin"], "correct_answer": "Hier", "explanation": "Ayer = Hier." },
        { "id": "fra2-5-q13", "type": "quiz_choice", "question": "Completa: Elle s'____ (Ella se viste).", "options": ["habille", "douche", "lève", "couche"], "correct_answer": "habille", "explanation": "S' se usa ante vocal o h muda, como en s'habille." },
        { "id": "fra2-5-q14", "type": "quiz_choice", "question": "¿Qué significa 'La gare'?", "options": ["La estación de tren", "El aeropuerto", "El autobús", "La calle"], "correct_answer": "La estación de tren", "explanation": "La gare = La estación de tren." },
        { "id": "fra2-5-q15", "type": "quiz_choice", "question": "Completa: Elles sont sorti____ (Ellas salieron).", "options": ["es", "s", "e", "Ninguna"], "correct_answer": "es", "explanation": "Femenino (e) + Plural (s) = es." },
        { "id": "fra2-5-q16", "type": "quiz_choice", "question": "¿Qué verbo es el auxiliar en 'J'ai eu' (Yo tuve)?", "options": ["Avoir", "Être", "Faire", "Aller"], "correct_answer": "Avoir", "explanation": "J'ai (Avoir) + eu (participio de Avoir)." },
        { "id": "fra2-5-q17", "type": "quiz_choice", "question": "¿Cómo se dice 'Ellos nacieron'?", "options": ["Ils sont nés", "Ils ont nés", "Ils sont né", "Ils ont né"], "correct_answer": "Ils sont nés", "explanation": "Naître usa Être y plural: Ils sont nés." },
        { "id": "fra2-5-q18", "type": "quiz_choice", "question": "¿Qué significa 'Tournez à gauche'?", "options": ["Gire a la izquierda", "Gire a la derecha", "Siga recto", "Pare en el semáforo"], "correct_answer": "Gire a la izquierda", "explanation": "À gauche = a la izquierda." },
        { "id": "fra2-5-q19", "type": "quiz_choice", "question": "¿Cómo se dice 'A pie' (Caminando)?", "options": ["À pied", "En pied", "Sur pied", "Le pied"], "correct_answer": "À pied", "explanation": "À pied." },
        { "id": "fra2-5-q20", "type": "quiz_choice", "question": "¿Cuál es la frase correcta?", "options": ["Je me suis douché", "J'ai me douché", "Je m'ai douché", "Je douché me"], "correct_answer": "Je me suis douché", "explanation": "Los verbos reflexivos SIEMPRE usan Être en pasado: Je me suis douché." }
