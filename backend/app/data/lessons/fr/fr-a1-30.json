        { "id": "fra1-30-q14", "type": "quiz_choice", "question": "¿Cómo se dice 'Me gustaría...'?", "options": ["Je voudrais", "Je veux", "J'aime", "Je mange"], "correct_answer": "Je voudrais", "explanation": "Je voudrais = Me gustaría." },
        { "id": "fra1-30-q15", "type": "quiz_choice", "question": "¿Qué es 'Une carafe d'eau'?", "options": ["Una jarra de agua del grifo (gratis)", "Un vaso de agua embotellada", "Agua con gas", "Una botella de vino"], "correct_answer": "Una jarra de agua del grifo (gratis)", "explanation": "Carafe d'eau = jarra de agua gratuita." },
