        { "id": "fra1-30-q2", "type": "quiz_choice", "question": "¿Qué terminación se añade al verbo para el pronombre 'Nous' (Nosotros)?", "options": ["-ons", "-ez", "-ent", "-e"], "correct_answer": "-ons", "explanation": "Nous usa '-ons' (Ej: Nous parlons)." },
