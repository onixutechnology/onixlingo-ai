        { "id": "fra1-30-q6", "type": "quiz_choice", "question": "¿Cómo se pronuncia 'Ils mangent' (Ellos comen)?", "options": ["La terminación '-ent' es completamente muda", "Suena como 'ent' al final", "Suena como 'on'", "Suena como 'an'"], "correct_answer": "La terminación '-ent' es completamente muda", "explanation": "En verbos, '-ent' nunca se pronuncia." },
        { "id": "fra1-30-q7", "type": "quiz_choice", "question": "Je mange ____ viande. (Como carne - femenino).", "options": ["de la", "du", "des", "de l'"], "correct_answer": "de la", "explanation": "Viande es femenino, usa 'de la'." },
