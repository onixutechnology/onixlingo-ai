        { "id": "fra1-30-q4", "type": "quiz_choice", "question": "¿Por qué es incorrecto decir 'Je veux un café' en un restaurante?", "options": ["Es de muy mala educación", "Café es femenino", "Significa 'No quiero'", "El verbo está mal conjugado"], "correct_answer": "Es de muy mala educación", "explanation": "Siempre usa 'Je voudrais' para pedir." },
