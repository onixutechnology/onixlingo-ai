        { "id": "fra1-30-q18", "type": "quiz_choice", "question": "¿Cómo preguntas '¿Dónde están los baños?'", "options": ["Où sont les toilettes ?", "Où est la toilette ?", "Où sont le bain ?", "La toilette s'il vous plaît ?"], "correct_answer": "Où sont les toilettes ?", "explanation": "En francés es plural: les toilettes." },
