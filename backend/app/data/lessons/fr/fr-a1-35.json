        { "id": "fra1-35-q4", "type": "quiz_choice", "question": "¿Cómo se dice 'El pantalón' en francés?", "options": ["Le pantalon", "Les pantalons", "Le pantale", "La jupe"], "correct_answer": "Le pantalon", "explanation": "En francés, pantalón es singular: Le pantalon." },
