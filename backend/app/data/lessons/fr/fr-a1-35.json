        { "id": "fra1-35-q6", "type": "quiz_choice", "question": "¿Qué significa 'Se doucher'?", "options": ["Ducharse", "Levantarse", "Acostarse", "Vestirse"], "correct_answer": "Ducharse", "explanation": "Se doucher = Ducharse." },
        { "id": "fra1-35-q7", "type": "quiz_choice", "question": "¿Cómo preguntas '¿Qué tiempo hace?'", "options": ["Quel temps fait-il ?", "Quel heure est-il ?", "Où est le soleil ?", "Comment est le temps ?"], "correct_answer": "Quel temps fait-il ?", "explanation": "Quel temps fait-il ? = ¿Qué tiempo hace?" },
