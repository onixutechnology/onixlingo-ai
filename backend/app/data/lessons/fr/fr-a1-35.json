        { "id": "fra1-35-q10", "type": "quiz_choice", "question": "¿Cómo se dice 'Hace calor'?", "options": ["Il fait chaud", "Il fait froid", "Il fait beau", "Il y a du soleil"], "correct_answer": "Il fait chaud", "explanation": "Il fait chaud = Hace calor." },
