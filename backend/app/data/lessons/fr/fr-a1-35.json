        { "id": "fra1-35-q16", "type": "quiz_choice", "question": "Completa: Il ____ (Él quiere) de l'eau.", "options": ["veut", "veux", "veulent", "peut"], "correct_answer": "veut", "explanation": "Vouloir para Il es 'veut'." },
        { "id": "fra1-35-q17", "type": "quiz_choice", "question": "¿Cómo se dice 'Hace frío'?", "options": ["Il fait froid", "Il fait chaud", "Il fait mauvais", "Il neige"], "correct_answer": "Il fait froid", "explanation": "Hace frío = Il fait froid." },
