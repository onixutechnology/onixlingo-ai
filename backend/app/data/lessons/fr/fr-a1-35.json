        { "id": "fra1-35-q12", "type": "quiz_choice", "question": "¿Qué significa 'La chemise'?", "options": ["La camisa (de botones)", "La camiseta", "El suéter", "El vestido"], "correct_answer": "La camisa (de botones)", "explanation": "La chemise = La camisa." },
