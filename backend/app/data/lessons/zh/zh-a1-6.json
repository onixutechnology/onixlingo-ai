        },
        {
          "visual": "Ayer: \"昨天\" (Zuótiān). Se coloca siempre al inicio o después del sujeto.",
          "audio": "昨天"
        },
        {
          "visual": "Hora / O'clock: \"点\" (Diǎn). Ejemplo: \"十点\" (Shí diǎn) - Las diez en punto.",
          "audio": "十点"
        },
        {
          "visual": "Día de la semana: \"星期\" (Xīngqī) + Número. Lunes es \"星期一\" (Xīngqīyī).",
          "audio": "星期一"
        },
        {
          "visual": "Reunirse: \"开会\" (Kāihuì). Expresión para juntas o reuniones laborales.",
          "audio": "今天开会"
        }
      ]
