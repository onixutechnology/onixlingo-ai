          "type": "quiz_choice",
          "question": "¿Cómo se dice 'Mañana (Día siguiente)' en chino?",
          "options": [
            "明天 (Míngtiān)",
            "今天 (Jīntiān)",
            "昨天 (Zuótiān)"
          ],
          "correct_answer": "明天 (Míngtiān)",
          "explanation": "明天 es mañana, jīntiān es hoy."
        },
        {
          "type": "quiz_choice",
          "question": "Traduce 'Hoy tenemos reunión':",
          "options": [
            "今天开会 (Jīntiān kāihuì)",
