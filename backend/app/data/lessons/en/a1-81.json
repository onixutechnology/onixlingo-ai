      "description": "Elige 'can' o 'can't' según el contexto.",
      "questions": [
        { "id": "a1-81-q1", "type": "quiz_choice", "question": "I ____ speak English. (Sí puedo).", "options": ["can", "can't", "don't", "am not"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q2", "type": "quiz_choice", "question": "She ____ use Excel very well. (Sí sabe).", "options": ["can", "can't", "doesn't", "isn't"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q3", "type": "quiz_choice", "question": "I ____ drive. I don't have a licence. (No puedo).", "options": ["can't", "can", "don't", "am not"], "correct_answer": "can't", "explanation": "Negación de habilidad (can't)." },
        { "id": "a1-81-q4", "type": "quiz_choice", "question": "He ____ attend the meeting. He is travelling. (No puede).", "options": ["can't", "can", "doesn't", "isn't"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q5", "type": "quiz_choice", "question": "____ you type quickly? (¿Puedes?).", "options": ["Can", "Do", "Are", "Have"], "correct_answer": "Can", "explanation": "Pregunta con can." },
        { "id": "a1-81-q6", "type": "quiz_choice", "question": "They ____ fix the server. The team is ready. (Sí pueden).", "options": ["can", "can't", "don't", "aren't"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q7", "type": "quiz_choice", "question": "I ____ find the file. Can you help me? (No puedo).", "options": ["can't", "can", "don't", "am not"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q8", "type": "quiz_choice", "question": "Mary ____ write reports in English. (Sí puede).", "options": ["can", "can't", "does", "is"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q9", "type": "quiz_choice", "question": "____ he speak French? (¿Puede él?).", "options": ["Can", "Does", "Is", "Has"], "correct_answer": "Can", "explanation": "Pregunta con can." },
        { "id": "a1-81-q10", "type": "quiz_choice", "question": "We ____ start the meeting without him. He is not here. (No podemos).", "options": ["can't", "can", "don't", "aren't"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q11", "type": "quiz_choice", "question": "I ____ help you with the presentation. (Sí puedo).", "options": ["can", "can't", "don't", "am not"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q12", "type": "quiz_choice", "question": "She ____ come to the office today. She is sick. (No puede).", "options": ["can't", "can", "doesn't", "isn't"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q13", "type": "quiz_choice", "question": "____ we reschedule the call? (¿Podemos?).", "options": ["Can", "Do", "Are", "Have"], "correct_answer": "Can", "explanation": "Pregunta con can." },
        { "id": "a1-81-q14", "type": "quiz_choice", "question": "He ____ use the new software. He had training. (Sí puede).", "options": ["can", "can't", "does", "is"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q15", "type": "quiz_choice", "question": "I ____ read the document. The font is too small. (No puedo).", "options": ["can't", "can", "don't", "am not"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q16", "type": "quiz_choice", "question": "The team ____ deliver the project on time. (Sí puede).", "options": ["can", "can't", "do", "are"], "correct_answer": "can", "explanation": "Habilidad positiva (can)." },
        { "id": "a1-81-q17", "type": "quiz_choice", "question": "I ____ hear you. Can you speak louder? (No puedo).", "options": ["can't", "can", "don't", "am not"], "correct_answer": "can't", "explanation": "Negación (can't)." },
        { "id": "a1-81-q18", "type": "quiz_choice", "question": "____ you send me the file? (¿Puedes?).", "options": ["Can", "Do", "Are", "Will"], "correct_answer": "Can", "explanation": "Pregunta con can (petición)." },
        { "id": "a1-81-q19", "type": "quiz_choice", "question": "No, I ____. I am in a meeting. (No puedo, respuesta).", "options": ["can't", "can", "don't", "am not"], "correct_answer": "can't", "explanation": "Respuesta negativa corta (can't)." },
        { "id": "a1-81-q20", "type": "quiz_choice", "question": "Yes, I ____. (Sí puedo, respuesta corta).", "options": ["can", "do", "am", "have"], "correct_answer": "can", "explanation": "Respuesta positiva corta (can)." }
      ]
