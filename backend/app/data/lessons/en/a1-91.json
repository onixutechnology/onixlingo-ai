      "type": "lecture",
      "title": "Concepto Teórico: Will (Futuro Simple)",
      "parts": [
        { "visual": "Estructura: Sujeto + will + Verbo en infinitivo. I will send the report (Enviaré el informe). She will call you (Ella te llamará).", "audio": "Structure: Subject plus will plus infinitive. I will send the report. She will call you." },
        { "visual": "Negativo: won't (will not). I won't be late (No llegaré tarde). Pregunta: Will you attend? (¿Asistirás?). Usos: Predicciones, promesas, decisiones espontáneas.", "audio": "Negative: won't, meaning will not. I won't be late. Question: Will you attend? Uses: Predictions, promises, and spontaneous decisions." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta con 'will' o 'won't'.",
      "questions": [
        { "id": "a1-91-q1", "type": "quiz_choice", "question": "I ____ send the report by noon. (Sí enviaré).", "options": ["will", "won't", "would", "do"], "correct_answer": "will", "explanation": "Promesa/decisión futura positiva (will)." },
        { "id": "a1-91-q2", "type": "quiz_choice", "question": "She ____ be late. She is always on time. (No llegará tarde).", "options": ["won't", "will", "doesn't", "can't"], "correct_answer": "won't", "explanation": "Negación futura (won't)." },
        { "id": "a1-91-q3", "type": "quiz_choice", "question": "____ you attend the meeting? (¿Asistirás?).", "options": ["Will", "Do", "Are", "Would"], "correct_answer": "Will", "explanation": "Pregunta con will." },
        { "id": "a1-91-q4", "type": "quiz_choice", "question": "I will ____ you the file. (enviar).", "options": ["send", "sends", "sending", "sent"], "correct_answer": "send", "explanation": "Will + infinitivo sin 'to'." },
        { "id": "a1-91-q5", "type": "quiz_choice", "question": "They ____ the contract tomorrow. (firmarán).", "options": ["will sign", "sign", "signed", "are sign"], "correct_answer": "will sign", "explanation": "Will + sign." },
        { "id": "a1-91-q6", "type": "quiz_choice", "question": "I think it ____ take two weeks. (tardará - predicción).", "options": ["will", "won't", "does", "is"], "correct_answer": "will", "explanation": "Predicción con will." },
        { "id": "a1-91-q7", "type": "quiz_choice", "question": "I ____ help you. No problem. (Decisión espontánea).", "options": ["will", "won't", "can't", "don't"], "correct_answer": "will", "explanation": "Decisión espontánea (will)." },
        { "id": "a1-91-q8", "type": "quiz_choice", "question": "We ____ miss the deadline. The project is on track. (No perderemos).", "options": ["won't", "will", "don't", "aren't"], "correct_answer": "won't", "explanation": "Negación futura (won't)." },
        { "id": "a1-91-q9", "type": "quiz_choice", "question": "____ the meeting be online? (¿Será en línea?).", "options": ["Will", "Is", "Do", "Are"], "correct_answer": "Will", "explanation": "Pregunta con will." },
        { "id": "a1-91-q10", "type": "quiz_choice", "question": "Yes, it ____. (Sí, respuesta corta).", "options": ["will", "do", "is", "does"], "correct_answer": "will", "explanation": "Yes, it will." },
        { "id": "a1-91-q11", "type": "quiz_choice", "question": "I will ____ you when I arrive. (llamar).", "options": ["call", "calls", "calling", "called"], "correct_answer": "call", "explanation": "Will + call." },
        { "id": "a1-91-q12", "type": "quiz_choice", "question": "The client ____ very impressed. (quedará - predicción).", "options": ["will be", "is", "was", "will is"], "correct_answer": "will be", "explanation": "Will be = será / quedará." },
        { "id": "a1-91-q13", "type": "quiz_choice", "question": "I ____ forget your help. (No olvidaré - promesa).", "options": ["won't", "will", "don't", "can't"], "correct_answer": "won't", "explanation": "Promesa negativa (won't)." },
        { "id": "a1-91-q14", "type": "quiz_choice", "question": "She ____ manage the project next month. (Gestionará).", "options": ["will manage", "manages", "managed", "is manage"], "correct_answer": "will manage", "explanation": "Will + manage." },
        { "id": "a1-91-q15", "type": "quiz_choice", "question": "____ you be in the office tomorrow? (Pregunta).", "options": ["Will", "Are", "Do", "Were"], "correct_answer": "Will", "explanation": "Pregunta con will." },
        { "id": "a1-91-q16", "type": "quiz_choice", "question": "I think sales ____ improve next quarter. (mejorarán).", "options": ["will", "won't", "do", "are"], "correct_answer": "will", "explanation": "Predicción con will." },
        { "id": "a1-91-q17", "type": "quiz_choice", "question": "We ____ need more budget. It is enough. (No necesitaremos).", "options": ["won't", "will", "don't", "aren't"], "correct_answer": "won't", "explanation": "Negación futura (won't)." },
        { "id": "a1-91-q18", "type": "quiz_choice", "question": "I'll ____ you with the presentation. (ayudar - I'll = I will).", "options": ["help", "helps", "helping", "helped"], "correct_answer": "help", "explanation": "I'll (= I will) + infinitivo." },
        { "id": "a1-91-q19", "type": "quiz_choice", "question": "The results ____ ready on Friday. (estarán).", "options": ["will be", "are", "were", "will is"], "correct_answer": "will be", "explanation": "Will be = estarán." },
        { "id": "a1-91-q20", "type": "quiz_choice", "question": "No, it ____. (No, respuesta corta negativa).", "options": ["won't", "will", "isn't", "doesn't"], "correct_answer": "won't", "explanation": "No, it won't." }
      ]
    },
