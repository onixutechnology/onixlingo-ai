        { "visual": "El 'small talk' (conversación informal) es muy importante en el mundo anglosajón. El clima es el tema más común: It's a lovely day, isn't it? (Es un día precioso, ¿verdad?).", "audio": "Small talk is very important in English-speaking business culture. Weather is the most common topic: It's a lovely day, isn't it?" },
        { "visual": "Otros temas seguros: How was your trip? (¿Qué tal el viaje?). How do you like the city? (¿Qué te parece la ciudad?). Did you have a good weekend? (¿Tuviste un buen fin de semana?).", "audio": "Other safe topics: How was your trip? How do you like the city? Did you have a good weekend?" }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la respuesta o expresión más apropiada para 'small talk'.",
      "questions": [
        { "id": "a1-99-q1", "type": "quiz_choice", "question": "It is a lovely day, ____? (Tag question).", "options": ["isn't it", "is it", "right", "yes"], "correct_answer": "isn't it", "explanation": "Tag question: isn't it?" },
        { "id": "a1-99-q2", "type": "quiz_choice", "question": "How was your ____? (Viaje).", "options": ["trip", "flight", "travel", "journey"], "correct_answer": "trip", "explanation": "How was your trip? = ¿Qué tal el viaje?" },
        { "id": "a1-99-q3", "type": "quiz_choice", "question": "It is very ____ today. (Caluroso).", "options": ["hot", "cold", "warm", "cool"], "correct_answer": "hot", "explanation": "Hot = caluroso." },
        { "id": "a1-99-q4", "type": "quiz_choice", "question": "It is ____ outside. I need an umbrella. (Lluvioso).", "options": ["raining", "cloudy", "windy", "sunny"], "correct_answer": "raining", "explanation": "It is raining = está lloviendo." },
        { "id": "a1-99-q5", "type": "quiz_choice", "question": "How do you ____ the city? (¿Qué te parece?).", "options": ["like", "find", "think", "see"], "correct_answer": "like", "explanation": "How do you like the city?" },
        { "id": "a1-99-q6", "type": "quiz_choice", "question": "Did you have a good ____? (Fin de semana).", "options": ["weekend", "week", "holiday", "day"], "correct_answer": "weekend", "explanation": "Good weekend = buen fin de semana." },
        { "id": "a1-99-q7", "type": "quiz_choice", "question": "Not ____. And you? (No mal. ¿Y tú? - respuesta).", "options": ["bad", "good", "great", "fine"], "correct_answer": "bad", "explanation": "Not bad = no mal." },
        { "id": "a1-99-q8", "type": "quiz_choice", "question": "It is the first ____ I have visited London. (Vez).", "options": ["time", "visit", "day", "chance"], "correct_answer": "time", "explanation": "First time = primera vez." },
        { "id": "a1-99-q9", "type": "quiz_choice", "question": "I love this city. It is ____. (Increíble).", "options": ["amazing", "nice", "good", "fine"], "correct_answer": "amazing", "explanation": "Amazing = increíble / asombroso." },
        { "id": "a1-99-q10", "type": "quiz_choice", "question": "The weather here is so ____. (Diferente).", "options": ["different", "strange", "unusual", "special"], "correct_answer": "different", "explanation": "Different = diferente." },
        { "id": "a1-99-q11", "type": "quiz_choice", "question": "What is the weather like ____? (En tu ciudad).", "options": ["in your city", "at your city", "from your city", "on your city"], "correct_answer": "in your city", "explanation": "In your city = en tu ciudad." },
        { "id": "a1-99-q12", "type": "quiz_choice", "question": "It is ____ in the winter. (Muy frío).", "options": ["very cold", "quite hot", "very warm", "a bit cool"], "correct_answer": "very cold", "explanation": "Very cold = muy frío." },
        { "id": "a1-99-q13", "type": "quiz_choice", "question": "How long are you ____? (¿Cuánto tiempo te quedas?).", "options": ["staying", "here", "visiting", "going"], "correct_answer": "staying", "explanation": "How long are you staying?" },
        { "id": "a1-99-q14", "type": "quiz_choice", "question": "I am here for ____ days. (Tres).", "options": ["three", "a few", "some", "two or three"], "correct_answer": "three", "explanation": "I am here for three days." },
        { "id": "a1-99-q15", "type": "quiz_choice", "question": "Is this your first time in ____? (Esta ciudad).", "options": ["the city", "this city", "here", "our city"], "correct_answer": "the city", "explanation": "First time in the city." },
        { "id": "a1-99-q16", "type": "quiz_choice", "question": "What do you ____ of the conference? (Pensar/Parecer).", "options": ["think", "like", "see", "find"], "correct_answer": "think", "explanation": "What do you think? = ¿Qué piensas?" },
        { "id": "a1-99-q17", "type": "quiz_choice", "question": "I think it is very ____. (Organizado).", "options": ["well-organized", "organized", "good", "professional"], "correct_answer": "well-organized", "explanation": "Well-organized = bien organizado." },
        { "id": "a1-99-q18", "type": "quiz_choice", "question": "It was nice ____ you. (Conocerte).", "options": ["meeting", "to meet", "to see", "talking to"], "correct_answer": "meeting", "explanation": "Nice meeting you = un placer conocerte." },
        { "id": "a1-99-q19", "type": "quiz_choice", "question": "Let's ____ in touch. (Mantenernos).", "options": ["keep", "stay", "be", "remain"], "correct_answer": "keep", "explanation": "Keep in touch = mantenerse en contacto." },
        { "id": "a1-99-q20", "type": "quiz_choice", "question": "Have a safe ____. (Viaje de regreso).", "options": ["trip back", "journey", "travel", "flight back"], "correct_answer": "trip back", "explanation": "Safe trip back = buen viaje de regreso." }
      ]
    },
