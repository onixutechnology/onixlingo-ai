      "questions": [
        { "id": "a1-121-q1", "type": "quiz_choice", "question": "I ____ working at 9 AM yesterday. (Estaba).", "options": ["was", "were", "am", "did"], "correct_answer": "was", "explanation": "I + was." },
        { "id": "a1-121-q2", "type": "quiz_choice", "question": "They ____ reviewing the contract at noon. (Estaban).", "options": ["were", "was", "are", "did"], "correct_answer": "were", "explanation": "They + were." },
        { "id": "a1-121-q3", "type": "quiz_choice", "question": "She ____ typing an email. (Estaba).", "options": ["was", "were", "is", "did"], "correct_answer": "was", "explanation": "She + was." },
        { "id": "a1-121-q4", "type": "quiz_choice", "question": "We ____ presenting the project. (Estábamos).", "options": ["were", "was", "are", "did"], "correct_answer": "were", "explanation": "We + were." },
        { "id": "a1-121-q5", "type": "quiz_choice", "question": "He was ____ on the report. (Trabajando).", "options": ["working", "work", "worked", "works"], "correct_answer": "working", "explanation": "was/were + verbo-ing." },
        { "id": "a1-121-q6", "type": "quiz_choice", "question": "What ____ you doing at 10 AM? (¿Qué estabas...?).", "options": ["were", "was", "are", "did"], "correct_answer": "were", "explanation": "Pregunta con you: were you." },
        { "id": "a1-121-q7", "type": "quiz_choice", "question": "I ____ listening to the manager. (No estaba).", "options": ["wasn't", "weren't", "didn't", "am not"], "correct_answer": "wasn't", "explanation": "I + wasn't." },
        { "id": "a1-121-q8", "type": "quiz_choice", "question": "The printer ____ working yesterday. (No estaba).", "options": ["wasn't", "weren't", "isn't", "didn't"], "correct_answer": "wasn't", "explanation": "The printer (it) + wasn't." },
        { "id": "a1-121-q9", "type": "quiz_choice", "question": "They ____ attending the conference. (No estaban).", "options": ["weren't", "wasn't", "didn't", "aren't"], "correct_answer": "weren't", "explanation": "They + weren't." },
        { "id": "a1-121-q10", "type": "quiz_choice", "question": "____ she reading the document? (¿Estaba ella...?).", "options": ["Was", "Were", "Did", "Is"], "correct_answer": "Was", "explanation": "Pregunta con she: Was she." },
        { "id": "a1-121-q11", "type": "quiz_choice", "question": "We were ____ the budget. (Discutiendo).", "options": ["discussing", "discuss", "discussed", "discusses"], "correct_answer": "discussing", "explanation": "were + verbo-ing." },
        { "id": "a1-121-q12", "type": "quiz_choice", "question": "I was ____ lunch when it happened. (Teniendo/Comiendo).", "options": ["having", "have", "had", "has"], "correct_answer": "having", "explanation": "was + having." },
        { "id": "a1-121-q13", "type": "quiz_choice", "question": "The clients ____ waiting in the lobby. (Estaban).", "options": ["were", "was", "are", "did"], "correct_answer": "were", "explanation": "The clients (they) + were." },
        { "id": "a1-121-q14", "type": "quiz_choice", "question": "It ____ raining heavily yesterday afternoon. (Estaba).", "options": ["was", "were", "is", "did"], "correct_answer": "was", "explanation": "It + was." },
        { "id": "a1-121-q15", "type": "quiz_choice", "question": "He was ____ on the phone. (Hablando).", "options": ["talking", "talk", "talked", "talks"], "correct_answer": "talking", "explanation": "was + talking." },
        { "id": "a1-121-q16", "type": "quiz_choice", "question": "____ they traveling to Tokyo? (¿Estaban ellos...?).", "options": ["Were", "Was", "Did", "Are"], "correct_answer": "Were", "explanation": "Pregunta con they: Were they." },
        { "id": "a1-121-q17", "type": "quiz_choice", "question": "Yes, I ____. (Respuesta corta positiva).", "options": ["was", "were", "did", "am"], "correct_answer": "was", "explanation": "Yes, I was." },
        { "id": "a1-121-q18", "type": "quiz_choice", "question": "No, they ____. (Respuesta corta negativa).", "options": ["weren't", "wasn't", "didn't", "aren't"], "correct_answer": "weren't", "explanation": "No, they weren't." },
        { "id": "a1-121-q19", "type": "quiz_choice", "question": "I wasn't ____ attention. (Prestando).", "options": ["paying", "pay", "paid", "pays"], "correct_answer": "paying", "explanation": "wasn't + paying." },
        { "id": "a1-121-q20", "type": "quiz_choice", "question": "She was ____ an email to the supplier. (Escribiendo).", "options": ["writing", "write", "wrote", "writes"], "correct_answer": "writing", "explanation": "was + writing." }
