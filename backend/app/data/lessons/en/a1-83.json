    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Presente Continuo",
      "parts": [
        { "visual": "Estructura: Sujeto + am/is/are + Verbo-ING. Uso 1 - Acción que ocurre AHORA: I am working (Estoy trabajando). She is calling (Ella está llamando).", "audio": "Structure: Subject plus am, is, or are plus verb ING. Use one is for actions happening now: I am working. She is calling." },
        { "visual": "Uso 2 - Plan futuro próximo (arreglo ya organizado): I am meeting John tomorrow (Voy a reunirme con John mañana). We are having a call at 3. (Tenemos una llamada a las 3).", "audio": "Use two is for near future arrangements already organized: I am meeting John tomorrow. We are having a call at three." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta del Presente Continuo.",
      "questions": [
        { "id": "a1-83-q1", "type": "quiz_choice", "question": "I ____ working on the report now.", "options": ["am", "is", "are", "be"], "correct_answer": "am", "explanation": "I + am para presente continuo." },
        { "id": "a1-83-q2", "type": "quiz_choice", "question": "She ____ talking to the client.", "options": ["is", "am", "are", "be"], "correct_answer": "is", "explanation": "She/He/It + is." },
        { "id": "a1-83-q3", "type": "quiz_choice", "question": "They ____ having a meeting.", "options": ["are", "is", "am", "be"], "correct_answer": "are", "explanation": "They/We/You + are." },
        { "id": "a1-83-q4", "type": "quiz_choice", "question": "I am ____. (Trabajar).", "options": ["working", "work", "worked", "works"], "correct_answer": "working", "explanation": "Presente continuo: trabajo + ing." },
        { "id": "a1-83-q5", "type": "quiz_choice", "question": "She is ____ a document. (Escribir).", "options": ["writing", "write", "wrote", "writes"], "correct_answer": "writing", "explanation": "Write termina en 'e', se quita la 'e' y se agrega 'ing'." },
        { "id": "a1-83-q6", "type": "quiz_choice", "question": "He is ____ a call. (Hacer).", "options": ["making", "make", "made", "makes"], "correct_answer": "making", "explanation": "Make -> making (se quita la 'e')." },
        { "id": "a1-83-q7", "type": "quiz_choice", "question": "We are ____ a presentation. (Dar).", "options": ["giving", "give", "gave", "gives"], "correct_answer": "giving", "explanation": "Give -> giving (se quita la 'e')." },
        { "id": "a1-83-q8", "type": "quiz_choice", "question": "I am ____ the files now. (Revisar).", "options": ["checking", "check", "checked", "checks"], "correct_answer": "checking", "explanation": "Check -> checking." },
        { "id": "a1-83-q9", "type": "quiz_choice", "question": "She is ____ an email. (Enviar).", "options": ["sending", "send", "sent", "sends"], "correct_answer": "sending", "explanation": "Send -> sending." },
        { "id": "a1-83-q10", "type": "quiz_choice", "question": "They are ____ in the conference room. (Sentarse).", "options": ["sitting", "sit", "sat", "sits"], "correct_answer": "sitting", "explanation": "Sit duplica la 't' antes de 'ing'." },
        { "id": "a1-83-q11", "type": "quiz_choice", "question": "I am ____ John tomorrow. (Reunirse con - plan futuro).", "options": ["meeting", "meet", "met", "meets"], "correct_answer": "meeting", "explanation": "Futuro próximo: meeting." },
        { "id": "a1-83-q12", "type": "quiz_choice", "question": "We are ____ dinner tonight. (Tener - plan futuro).", "options": ["having", "have", "had", "has"], "correct_answer": "having", "explanation": "Have -> having (se quita la 'e')." },
        { "id": "a1-83-q13", "type": "quiz_choice", "question": "She is ____ tomorrow. (Volar - plan futuro).", "options": ["flying", "fly", "flew", "flys"], "correct_answer": "flying", "explanation": "Fly -> flying (y sigue siendo y)." },
        { "id": "a1-83-q14", "type": "quiz_choice", "question": "____ you working? (¿Estás...?).", "options": ["Are", "Is", "Am", "Do"], "correct_answer": "Are", "explanation": "Pregunta con 'are' para 'you'." },
        { "id": "a1-83-q15", "type": "quiz_choice", "question": "____ she attending the meeting? (¿Está ella...?).", "options": ["Is", "Are", "Am", "Does"], "correct_answer": "Is", "explanation": "Pregunta con 'is' para 'she'." },
        { "id": "a1-83-q16", "type": "quiz_choice", "question": "I am not ____. (Trabajar - negativo).", "options": ["working", "work", "worked", "works"], "correct_answer": "working", "explanation": "Negativo: am not + working." },
        { "id": "a1-83-q17", "type": "quiz_choice", "question": "He is not ____ right now. (Contestar el teléfono - negativo).", "options": ["answering", "answer", "answered", "answers"], "correct_answer": "answering", "explanation": "Answer -> answering." },
        { "id": "a1-83-q18", "type": "quiz_choice", "question": "They are not ____ today. (Venir - negativo).", "options": ["coming", "come", "came", "comes"], "correct_answer": "coming", "explanation": "Come -> coming (se quita la 'e')." },
        { "id": "a1-83-q19", "type": "quiz_choice", "question": "What are you ____? (Hacer).", "options": ["doing", "do", "did", "does"], "correct_answer": "doing", "explanation": "Do -> doing." },
        { "id": "a1-83-q20", "type": "quiz_choice", "question": "I am ____ the project tomorrow. (Presentar - plan).", "options": ["presenting", "present", "presented", "presents"], "correct_answer": "presenting", "explanation": "Present -> presenting." }
      ]
