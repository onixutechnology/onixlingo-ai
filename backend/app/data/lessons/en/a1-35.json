        { "id": "a1-35-q10", "type": "quiz_choice", "question": "I don't ____ so.", "options": ["think", "thinks", "thinking", "thought"], "correct_answer": "think", "explanation": "No lo creo (I don't think so)." },
        { "id": "a1-35-q11", "type": "quiz_choice", "question": "____ my opinion, it's too expensive.", "options": ["In", "On", "At", "For"], "correct_answer": "In", "explanation": "In my opinion." },
        { "id": "a1-35-q12", "type": "quiz_choice", "question": "I ____ that is a mistake.", "options": ["believe", "believes", "believing", "believed"], "correct_answer": "believe", "explanation": "Creo (believe)." },
        { "id": "a1-35-q13", "type": "quiz_choice", "question": "That's exactly what I ____.", "options": ["think", "thinks", "thinking", "thought"], "correct_answer": "think", "explanation": "Eso es exactamente lo que pienso." },
        { "id": "a1-35-q14", "type": "quiz_choice", "question": "I ____ your point.", "options": ["see", "look", "watch", "view"], "correct_answer": "see", "explanation": "Entiendo tu punto (I see your point)." },
        { "id": "a1-35-q15", "type": "quiz_choice", "question": "I'm not ____ about that.", "options": ["sure", "know", "think", "agree"], "correct_answer": "sure", "explanation": "No estoy seguro (I'm not sure)." },
        { "id": "a1-35-q16", "type": "quiz_choice", "question": "Let's ____ on this plan.", "options": ["agree", "think", "opinion", "idea"], "correct_answer": "agree", "explanation": "Vamos a acordar este plan." },
        { "id": "a1-35-q17", "type": "quiz_choice", "question": "I ____ to differ.", "options": ["beg", "ask", "want", "need"], "correct_answer": "beg", "explanation": "I beg to differ (difiero, respetuosamente)." },
        { "id": "a1-35-q18", "type": "quiz_choice", "question": "It ____ to me that we are late.", "options": ["seems", "seem", "seeming", "seemed"], "correct_answer": "seems", "explanation": "Me parece que (It seems to me)." },
        { "id": "a1-35-q19", "type": "quiz_choice", "question": "I ____ understand why.", "options": ["don't", "not", "doesn't", "am not"], "correct_answer": "don't", "explanation": "No entiendo por qué." },
        { "id": "a1-35-q20", "type": "quiz_choice", "question": "Do you ____?", "options": ["agree", "agrees", "agreed", "agreeing"], "correct_answer": "agree", "explanation": "¿Estás de acuerdo?" }
