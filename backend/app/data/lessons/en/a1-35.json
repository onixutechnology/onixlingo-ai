        { "id": "a1-35-q1", "type": "quiz_choice", "question": "I ____ this is a good idea.", "options": ["think", "thinks", "thinking", "thought"], "correct_answer": "think", "explanation": "Creo que esto es una buena idea (I think)." },
        { "id": "a1-35-q2", "type": "quiz_choice", "question": "In my ____, we need more time.", "options": ["opinion", "idea", "mind", "head"], "correct_answer": "opinion", "explanation": "En mi opinión." },
