      "id": "stg_theory",
      "type": "lecture",
      "title": "Voz Pasiva + Verbos Modales",
      "parts": [
        { "visual": "En los negocios, frecuentemente combinamos verbos modales (can, must, should) con la voz pasiva para indicar obligación o posibilidad formal. \nEstructura: Modal + BE + Participio Pasado.", "audio": "In business, we often combine modal verbs like can, must, or should with the passive voice to indicate formal obligation or possibility. The structure is: Modal verb, plus BE, plus a Past Participle." },
        { "visual": "Ejemplos: \n- MUST: The report MUST BE FINISHED today (El reporte debe ser terminado hoy). \n- CAN: The problem CAN BE SOLVED (El problema puede ser resuelto). \n- SHOULD: The email SHOULD BE SENT now (El correo debería ser enviado ahora).", "audio": "Examples. With MUST: The report must be finished today. With CAN: The problem can be solved. With SHOULD: The email should be sent now." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta de la voz pasiva con modales.",
      "questions": [
        { "id": "b1-31-q1", "type": "quiz_choice", "question": "This form ____ filled out in black ink. (Debe ser).", "options": ["must be", "must", "must is", "must are"], "correct_answer": "must be", "explanation": "Must + be + participio = must be filled out." },
        { "id": "b1-31-q2", "type": "quiz_choice", "question": "The meeting ____ postponed until next week. (Puede ser).", "options": ["can be", "can", "can is", "can are"], "correct_answer": "can be", "explanation": "Can + be + participio = can be postponed." },
        { "id": "b1-31-q3", "type": "quiz_choice", "question": "The new software ____ installed tomorrow. (Será).", "options": ["will be", "will", "will is", "will are"], "correct_answer": "will be", "explanation": "Will + be + participio = will be installed." },
        { "id": "b1-31-q4", "type": "quiz_choice", "question": "This mistake ____ avoided. (Podría ser / Podría haber sido evitado, pero en presente: podría ser).", "options": ["could be", "could", "could is", "could are"], "correct_answer": "could be", "explanation": "Could + be = could be avoided." },
        { "id": "b1-31-q5", "type": "quiz_choice", "question": "The contract ____ signed by the CEO. (Tiene que ser).", "options": ["has to be", "have to be", "has be", "has to is"], "correct_answer": "has to be", "explanation": "Para 'the contract' (it) usamos 'has to be'." },
        { "id": "b1-31-q6", "type": "quiz_choice", "question": "All employees ____ trained on the new system. (Deberían ser).", "options": ["should be", "should", "should are", "should been"], "correct_answer": "should be", "explanation": "Should + be = should be trained." },
        { "id": "b1-31-q7", "type": "quiz_choice", "question": "Mobile phones ____ turned off during the presentation. (Deben estar / ser).", "options": ["must be", "must", "must are", "must been"], "correct_answer": "must be", "explanation": "Must be turned off." },
        { "id": "b1-31-q8", "type": "quiz_choice", "question": "The budget ____ approved by the board of directors. (Necesita ser).", "options": ["needs to be", "need to be", "needs be", "need be"], "correct_answer": "needs to be", "explanation": "Needs to be approved." },
        { "id": "b1-31-q9", "type": "quiz_choice", "question": "This problem ____ fixed immediately. (Tiene que ser).", "options": ["has to be", "have to be", "has be", "has to is"], "correct_answer": "has to be", "explanation": "Has to be fixed." },
        { "id": "b1-31-q10", "type": "quiz_choice", "question": "The password ____ changed every 90 days. (Debe ser).", "options": ["must be", "must", "must is", "must been"], "correct_answer": "must be", "explanation": "Must be changed." },
        { "id": "b1-31-q11", "type": "quiz_choice", "question": "The delivery ____ delayed because of the storm. (Podría ser).", "options": ["might be", "might", "might is", "might are"], "correct_answer": "might be", "explanation": "Might be delayed (es una posibilidad)." },
        { "id": "b1-31-q12", "type": "quiz_choice", "question": "Taxes ____ paid before April 15th. (Deben ser).", "options": ["must be", "must", "must are", "must been"], "correct_answer": "must be", "explanation": "Must be paid." },
        { "id": "b1-31-q13", "type": "quiz_choice", "question": "The results ____ published next month. (Serán).", "options": ["will be", "will", "will are", "will been"], "correct_answer": "will be", "explanation": "Will be published." },
        { "id": "b1-31-q14", "type": "quiz_choice", "question": "This equipment ____ used without training. (No debe ser).", "options": ["must not be", "must be not", "not must be", "must not is"], "correct_answer": "must not be", "explanation": "Must not be used (Prohibición)." },
        { "id": "b1-31-q15", "type": "quiz_choice", "question": "The office ____ cleaned every evening. (Debería ser).", "options": ["should be", "should", "should is", "should been"], "correct_answer": "should be", "explanation": "Should be cleaned." },
        { "id": "b1-31-q16", "type": "quiz_choice", "question": "The rules ____ followed by everyone. (Tienen que ser).", "options": ["have to be", "has to be", "have be", "have to is"], "correct_answer": "have to be", "explanation": "The rules (plural) = have to be followed." },
        { "id": "b1-31-q17", "type": "quiz_choice", "question": "A solution ____ found soon. (Puede ser).", "options": ["can be", "can", "can is", "can are"], "correct_answer": "can be", "explanation": "Can be found." },
        { "id": "b1-31-q18", "type": "quiz_choice", "question": "Safety helmets ____ worn at all times. (Deben ser).", "options": ["must be", "must", "must are", "must been"], "correct_answer": "must be", "explanation": "Must be worn." },
        { "id": "b1-31-q19", "type": "quiz_choice", "question": "Your luggage ____ checked at the airport. (Será).", "options": ["will be", "will", "will is", "will are"], "correct_answer": "will be", "explanation": "Will be checked." },
        { "id": "b1-31-q20", "type": "quiz_choice", "question": "This information ____ shared with anyone outside the company. (No debería ser).", "options": ["should not be", "should be not", "not should be", "should not is"], "correct_answer": "should not be", "explanation": "Should not be shared." }
      ]
    },
