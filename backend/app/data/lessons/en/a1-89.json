      "title": "Concepto Teórico: Hablar de un Proyecto Pasado",
      "parts": [
        { "visual": "Para describir un proyecto pasado usamos el pasado simple: 'Last year, we launched a new product' (El año pasado lanzamos un producto nuevo).", "audio": "To describe a past project we use the simple past: Last year, we launched a new product." },
        { "visual": "Expresiones de tiempo pasado útiles: Last week / month / year (La semana / mes / año pasado). Yesterday (Ayer). In January (En enero). Two days ago (Hace dos días).", "audio": "Useful past time expressions: Last week, last month, last year. Yesterday. In January. Two days ago." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la opción correcta para hablar de un proyecto pasado.",
      "questions": [
        { "id": "a1-89-q1", "type": "quiz_choice", "question": "Last ____, we finished the project. (semana).", "options": ["week", "month", "year", "night"], "correct_answer": "week", "explanation": "Last week = La semana pasada." },
        { "id": "a1-89-q2", "type": "quiz_choice", "question": "We ____ the product in January. (lanzamos).", "options": ["launched", "launch", "launching", "launches"], "correct_answer": "launched", "explanation": "Launched = lanzamos (pasado simple)." },
        { "id": "a1-89-q3", "type": "quiz_choice", "question": "The project ____ six months. (duró).", "options": ["took", "take", "taking", "takes"], "correct_answer": "took", "explanation": "Take -> Took = durar / tomar tiempo." },
        { "id": "a1-89-q4", "type": "quiz_choice", "question": "I ____ the project manager. (fui/era).", "options": ["was", "am", "were", "be"], "correct_answer": "was", "explanation": "I + was (pasado)." },
        { "id": "a1-89-q5", "type": "quiz_choice", "question": "The team ____ five people. (tenía).", "options": ["had", "have", "has", "having"], "correct_answer": "had", "explanation": "Have -> Had." },
        { "id": "a1-89-q6", "type": "quiz_choice", "question": "We ____ our goal. (alcanzamos).", "options": ["achieved", "achieve", "achieving", "achieves"], "correct_answer": "achieved", "explanation": "Achieve -> Achieved." },
        { "id": "a1-89-q7", "type": "quiz_choice", "question": "Two days ____, we had a review meeting. (hace).", "options": ["ago", "before", "past", "back"], "correct_answer": "ago", "explanation": "Ago = hace (tiempo)." },
        { "id": "a1-89-q8", "type": "quiz_choice", "question": "The project was a ____ (éxito).", "options": ["success", "succeed", "successful", "succeeding"], "correct_answer": "success", "explanation": "Success = éxito (sustantivo)." },
        { "id": "a1-89-q9", "type": "quiz_choice", "question": "We ____ on time. (entregamos).", "options": ["delivered", "deliver", "delivering", "delivers"], "correct_answer": "delivered", "explanation": "Deliver -> Delivered." },
        { "id": "a1-89-q10", "type": "quiz_choice", "question": "The client ____ happy with the results. (estaba).", "options": ["was", "were", "is", "am"], "correct_answer": "was", "explanation": "The client (it/she/he) + was." },
        { "id": "a1-89-q11", "type": "quiz_choice", "question": "We ____ a new system. (implementamos).", "options": ["implemented", "implement", "implementing", "implements"], "correct_answer": "implemented", "explanation": "Implement -> Implemented." },
        { "id": "a1-89-q12", "type": "quiz_choice", "question": "The budget ____ under control. (estuvo).", "options": ["was", "were", "is", "stayed"], "correct_answer": "was", "explanation": "Budget (it) + was." },
        { "id": "a1-89-q13", "type": "quiz_choice", "question": "We ____ the deadline. (cumplimos).", "options": ["met", "meet", "meeting", "meets"], "correct_answer": "met", "explanation": "Meet -> Met (también 'cumplir con')." },
        { "id": "a1-89-q14", "type": "quiz_choice", "question": "The project started ____ January. (en).", "options": ["in", "on", "at", "to"], "correct_answer": "in", "explanation": "Meses usan 'in'." },
        { "id": "a1-89-q15", "type": "quiz_choice", "question": "It ____ on March 15th. (terminó).", "options": ["ended", "end", "ending", "ends"], "correct_answer": "ended", "explanation": "End -> Ended." },
        { "id": "a1-89-q16", "type": "quiz_choice", "question": "We faced some ____. (desafíos).", "options": ["challenges", "challenge", "charged", "choice"], "correct_answer": "challenges", "explanation": "Challenges = desafíos." },
        { "id": "a1-89-q17", "type": "quiz_choice", "question": "We ____ the problem quickly. (resolvimos).", "options": ["solved", "solve", "solving", "solves"], "correct_answer": "solved", "explanation": "Solve -> Solved." },
        { "id": "a1-89-q18", "type": "quiz_choice", "question": "Overall, the project ____ well. (salió/resultó).", "options": ["went", "go", "goes", "going"], "correct_answer": "went", "explanation": "Go -> Went (go well = salir bien)." },
        { "id": "a1-89-q19", "type": "quiz_choice", "question": "We ____ great feedback from the client. (recibimos).", "options": ["received", "receive", "receiving", "receives"], "correct_answer": "received", "explanation": "Receive -> Received." },
        { "id": "a1-89-q20", "type": "quiz_choice", "question": "In the end, we ____ our objectives. (logramos).", "options": ["achieved", "achieve", "achieving", "achieves"], "correct_answer": "achieved", "explanation": "Achieve -> Achieved." }
      ]
    },
