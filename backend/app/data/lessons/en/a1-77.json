        { "id": "a1-77-q1", "type": "quiz_choice", "question": "My computer is ____ than yours (fast - rápido).", "options": ["faster", "fast", "fastest", "more fast"], "correct_answer": "faster", "explanation": "Fast + er = faster (más rápido)." },
        { "id": "a1-77-q2", "type": "quiz_choice", "question": "This printer is ____ than the old one (cheap - barato).", "options": ["cheaper", "cheap", "cheapest", "more cheap"], "correct_answer": "cheaper", "explanation": "Cheap + er = cheaper (más barato)." },
        { "id": "a1-77-q3", "type": "quiz_choice", "question": "The new office is ____ than the old one (big - grande).", "options": ["bigger", "biger", "more big", "big"], "correct_answer": "bigger", "explanation": "Big duplica la 'g' -> bigger (más grande)." },
