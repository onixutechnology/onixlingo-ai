        { "id": "a1-55-q1", "type": "quiz_choice", "question": "The boss walked ____ the meeting room (hacia adentro).", "options": ["into", "out of", "through", "past"], "correct_answer": "into", "explanation": "Hacia adentro (into)." },
        { "id": "a1-55-q2", "type": "quiz_choice", "question": "He ran ____ the building (hacia afuera).", "options": ["out of", "into", "through", "across"], "correct_answer": "out of", "explanation": "Hacia afuera (out of)." },
        { "id": "a1-55-q3", "type": "quiz_choice", "question": "Go ____ the double doors (a través de).", "options": ["through", "over", "under", "into"], "correct_answer": "through", "explanation": "A través de (through)." },
        { "id": "a1-55-q4", "type": "quiz_choice", "question": "Walk ____ the reception desk (en dirección a).", "options": ["toward", "into", "out of", "under"], "correct_answer": "toward", "explanation": "En dirección a / hacia (toward)." },
        { "id": "a1-55-q5", "type": "quiz_choice", "question": "We drove ____ the bridge (por encima).", "options": ["over", "under", "through", "into"], "correct_answer": "over", "explanation": "Por encima de (over)." },
        { "id": "a1-55-q6", "type": "quiz_choice", "question": "The cat went ____ the desk (por debajo).", "options": ["under", "over", "into", "through"], "correct_answer": "under", "explanation": "Por debajo (under)." },
        { "id": "a1-55-q7", "type": "quiz_choice", "question": "Walk ____ the street (cruzar de un lado a otro).", "options": ["across", "into", "through", "under"], "correct_answer": "across", "explanation": "Cruzar de lado a lado (across)." },
