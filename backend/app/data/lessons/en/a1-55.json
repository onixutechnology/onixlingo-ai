        { "id": "a1-55-q15", "type": "quiz_choice", "question": "The ball rolled ____ the table (cayó de la mesa).", "options": ["off", "out of", "into", "over"], "correct_answer": "off", "explanation": "Salir de la superficie hacia abajo (fall off)." },
        { "id": "a1-55-q16", "type": "quiz_choice", "question": "Put the files ____ the cabinet (hacia adentro).", "options": ["into", "onto", "over", "past"], "correct_answer": "into", "explanation": "Hacia el interior (into)." },
