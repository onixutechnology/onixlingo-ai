        { "id": "a1-55-q12", "type": "quiz_choice", "question": "Get ____ the train (subir al tren/bus).", "options": ["on", "in", "into", "under"], "correct_answer": "on", "explanation": "Subir a un transporte grande donde puedes caminar (get on)." },
        { "id": "a1-55-q13", "type": "quiz_choice", "question": "Get ____ the taxi (bajar del taxi).", "options": ["out of", "off", "down", "under"], "correct_answer": "out of", "explanation": "Bajar de auto/taxi (get out of)." },
