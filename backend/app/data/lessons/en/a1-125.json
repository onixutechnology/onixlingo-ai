      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Imperativos",
      "parts": [
        { "visual": "Usamos el Imperativo para dar instrucciones, órdenes o advertencias. El sujeto ('You') NO se dice. Solo usamos la forma base del verbo. Ejemplo: Press the button (Presiona el botón). Turn on the computer (Enciende la computadora).", "audio": "We use the Imperative to give instructions, orders, or warnings. The subject 'You' is NOT spoken. We just use the base form of the verb. Example: Press the button. Turn on the computer." },
        { "visual": "Para instrucciones negativas, usamos 'Don't' + verbo. Ejemplo: Don't unplug the printer (No desconectes la impresora). Don't turn off the screen (No apagues la pantalla). Podemos añadir 'Please' para ser más amables: Please press the button.", "audio": "For negative instructions, we use Don't plus the verb. Example: Don't unplug the printer. Don't turn off the screen. We can add 'Please' to be more polite: Please press the button." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta del imperativo para dar instrucciones.",
      "questions": [
        { "id": "a1-125-q1", "type": "quiz_choice", "question": "____ the green button to start. (Presiona).", "options": ["Press", "Presses", "To press", "Pressing"], "correct_answer": "Press", "explanation": "Imperativo afirmativo: verbo base (Press)." },
        { "id": "a1-125-q2", "type": "quiz_choice", "question": "____ unplug the machine while it is printing. (No desconectes).", "options": ["Don't", "Not", "Doesn't", "No"], "correct_answer": "Don't", "explanation": "Imperativo negativo: Don't + verbo." },
        { "id": "a1-125-q3", "type": "quiz_choice", "question": "Please ____ the computer after work. (Apaga - Turn off).", "options": ["turn off", "turning off", "turns off", "turned off"], "correct_answer": "turn off", "explanation": "Verbo base: turn off." },
        { "id": "a1-125-q4", "type": "quiz_choice", "question": "____ the document in the scanner face down. (Pon/Coloca).", "options": ["Put", "Puts", "Putting", "To put"], "correct_answer": "Put", "explanation": "Verbo base: Put." },
        { "id": "a1-125-q5", "type": "quiz_choice", "question": "____ open this cover. (No abras).", "options": ["Don't", "No", "Not", "Doesn't"], "correct_answer": "Don't", "explanation": "Don't open." },
        { "id": "a1-125-q6", "type": "quiz_choice", "question": "____ your password to log in. (Ingresa/Escribe).", "options": ["Enter", "Enters", "Entering", "To enter"], "correct_answer": "Enter", "explanation": "Enter." },
        { "id": "a1-125-q7", "type": "quiz_choice", "question": "____ forget to save your work. (No olvides).", "options": ["Don't", "Doesn't", "Not", "No"], "correct_answer": "Don't", "explanation": "Don't forget." },
        { "id": "a1-125-q8", "type": "quiz_choice", "question": "____ sure the tray is closed. (Asegúrate/Make).", "options": ["Make", "Makes", "Making", "To make"], "correct_answer": "Make", "explanation": "Make sure." },
        { "id": "a1-125-q9", "type": "quiz_choice", "question": "____ pull the paper if it jams. (No jales).", "options": ["Don't", "Doesn't", "Not", "No"], "correct_answer": "Don't", "explanation": "Don't pull." },
        { "id": "a1-125-q10", "type": "quiz_choice", "question": "____ the machine on the wall socket. (Conecta - Plug).", "options": ["Plug", "Plugs", "Plugging", "To plug"], "correct_answer": "Plug", "explanation": "Plug." },
        { "id": "a1-125-q11", "type": "quiz_choice", "question": "____ wait for the green light. (Espera).", "options": ["Wait", "Waits", "Waiting", "To wait"], "correct_answer": "Wait", "explanation": "Wait." },
        { "id": "a1-125-q12", "type": "quiz_choice", "question": "____ leave confidential documents on the desk. (No dejes).", "options": ["Don't", "No", "Not", "Doesn't"], "correct_answer": "Don't", "explanation": "Don't leave." },
        { "id": "a1-125-q13", "type": "quiz_choice", "question": "____ 'print' on the screen. (Haz clic - Click).", "options": ["Click", "Clicks", "Clicking", "To click"], "correct_answer": "Click", "explanation": "Click." },
        { "id": "a1-125-q14", "type": "quiz_choice", "question": "____ the paper drawer to load paper. (Abre).", "options": ["Open", "Opens", "Opening", "To open"], "correct_answer": "Open", "explanation": "Open." },
        { "id": "a1-125-q15", "type": "quiz_choice", "question": "Please ____ the ink cartridge carefully. (Reemplaza).", "options": ["replace", "replaces", "replacing", "to replace"], "correct_answer": "replace", "explanation": "replace." },
        { "id": "a1-125-q16", "type": "quiz_choice", "question": "____ drink coffee near the keyboard. (No bebas).", "options": ["Don't", "Not", "Doesn't", "No"], "correct_answer": "Don't", "explanation": "Don't drink." },
        { "id": "a1-125-q17", "type": "quiz_choice", "question": "____ the IT department if the error continues. (Llama).", "options": ["Call", "Calls", "Calling", "To call"], "correct_answer": "Call", "explanation": "Call." },
        { "id": "a1-125-q18", "type": "quiz_choice", "question": "____ use force to close the scanner. (No uses).", "options": ["Don't", "Doesn't", "Not", "No"], "correct_answer": "Don't", "explanation": "Don't use." },
        { "id": "a1-125-q19", "type": "quiz_choice", "question": "____ the projector to the laptop. (Conecta - Connect).", "options": ["Connect", "Connects", "Connecting", "To connect"], "correct_answer": "Connect", "explanation": "Connect." },
        { "id": "a1-125-q20", "type": "quiz_choice", "question": "____ off the lights when you leave the room. (Apaga).", "options": ["Turn", "Turns", "Turning", "To turn"], "correct_answer": "Turn", "explanation": "Turn (off)." }
      ]
    },
