        { "id": "a1-96-q13", "type": "quiz_choice", "question": "Where is the ____? I need to check in. (Mostrador).", "options": ["check-in desk", "boarding gate", "customs", "terminal"], "correct_answer": "check-in desk", "explanation": "Check-in desk = mostrador de facturación." },
