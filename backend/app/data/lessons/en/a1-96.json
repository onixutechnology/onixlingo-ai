        { "id": "a1-96-q2", "type": "quiz_choice", "question": "I need to ____ a flight to New York. (Reservar).", "options": ["book", "take", "catch", "find"], "correct_answer": "book", "explanation": "Book a flight = reservar un vuelo." },
