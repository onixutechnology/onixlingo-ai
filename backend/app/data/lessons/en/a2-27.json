  "stages": [
    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Adverbs of Manner (Adverbios de Manera)",
      "parts": [
        { "visual": "Los Adjetivos describen sustantivos (a quick worker). Los Adverbios de Manera describen CÓMO ocurre una acción (He works quickly = Él trabaja rápidamente). \nRegla general: Adjetivo + 'LY'. (Quick -> Quickly, Careful -> Carefully).", "audio": "Adjectives describe nouns, for example: a quick worker. Adverbs of manner describe HOW an action happens, for example: He works quickly. General rule: Add L-Y to the adjective." },
        { "visual": "Excepciones irregulares: \nGood (adjetivo) -> Well (adverbio). Ej: He is a good worker. He works well. \nFast -> Fast. Hard -> Hard. Late -> Late. Early -> Early. No cambian.", "audio": "Irregular exceptions: Good becomes well. For example: He is a good worker, he works well. Fast stays fast. Hard stays hard. Late stays late, and early stays early. They don't change." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige el adjetivo o adverbio correcto según el contexto.",
      "questions": [
        { "id": "a2-27-q1", "type": "quiz_choice", "question": "She is a ____ worker. (Adjetivo describiendo al sustantivo).", "options": ["careful", "carefully", "care", "caring"], "correct_answer": "careful", "explanation": "Describe a 'worker' (sustantivo), usamos el adjetivo: careful (cuidadoso)." },
        { "id": "a2-27-q2", "type": "quiz_choice", "question": "She works very ____. (Adverbio describiendo el verbo).", "options": ["carefully", "careful", "caring", "care"], "correct_answer": "carefully", "explanation": "Describe cómo trabaja (verbo works), usamos el adverbio: carefully (cuidadosamente)." },
        { "id": "a2-27-q3", "type": "quiz_choice", "question": "He is a ____ speaker. (Adjetivo).", "options": ["good", "well", "goods", "better"], "correct_answer": "good", "explanation": "Describe a 'speaker' = good (buen)." },
        { "id": "a2-27-q4", "type": "quiz_choice", "question": "He speaks English very ____. (Adverbio de good).", "options": ["well", "good", "goodly", "best"], "correct_answer": "well", "explanation": "Describe cómo habla (speak). El adverbio de good es well." },
        { "id": "a2-27-q5", "type": "quiz_choice", "question": "Please reply to this email ____. (Rápidamente).", "options": ["quickly", "quick", "fastly", "quicker"], "correct_answer": "quickly", "explanation": "Adverbio de quick = quickly (rápidamente)." },
        { "id": "a2-27-q6", "type": "quiz_choice", "question": "He has a very ____ car. (Adjetivo).", "options": ["fast", "fastly", "quick", "rapid"], "correct_answer": "fast", "explanation": "Adjetivo para describir el auto: fast." },
        { "id": "a2-27-q7", "type": "quiz_choice", "question": "He drives very ____. (Adverbio).", "options": ["fast", "fastly", "quick", "fasting"], "correct_answer": "fast", "explanation": "El adverbio de fast es fast (no existe fastly)." },
        { "id": "a2-27-q8", "type": "quiz_choice", "question": "They are ____ workers. (Duros/Trabajadores - Adjetivo).", "options": ["hard", "hardly", "harder", "hards"], "correct_answer": "hard", "explanation": "Adjetivo = hard." },
        { "id": "a2-27-q9", "type": "quiz_choice", "question": "They work very ____. (Duro - Adverbio).", "options": ["hard", "hardly", "hards", "harder"], "correct_answer": "hard", "explanation": "El adverbio de manera de hard es hard (hardly significa 'apenas/casi no')." },
        { "id": "a2-27-q10", "type": "quiz_choice", "question": "I can ____ hear you. The connection is bad. (Apenas/Casi no).", "options": ["hardly", "hard", "harder", "bad"], "correct_answer": "hardly", "explanation": "Hardly no es adverbio de manera de hard, es un adverbio de grado que significa 'apenas' (casi nada)." },
        { "id": "a2-27-q11", "type": "quiz_choice", "question": "It was an ____ meeting. (Adjetivo - fácil).", "options": ["easy", "easily", "ease", "easier"], "correct_answer": "easy", "explanation": "Adjetivo = easy." },
        { "id": "a2-27-q12", "type": "quiz_choice", "question": "She solved the problem ____. (Adverbio - fácilmente).", "options": ["easily", "easy", "easier", "ease"], "correct_answer": "easily", "explanation": "Adverbio de easy = easily (se cambia la 'y' por 'i')." },
        { "id": "a2-27-q13", "type": "quiz_choice", "question": "The CEO spoke very ____ during the presentation. (Claramente).", "options": ["clearly", "clear", "clears", "clearing"], "correct_answer": "clearly", "explanation": "Adverbio de clear = clearly." },
        { "id": "a2-27-q14", "type": "quiz_choice", "question": "That is a ____ idea. (Mala).", "options": ["bad", "badly", "worse", "worst"], "correct_answer": "bad", "explanation": "Adjetivo para idea = bad." },
        { "id": "a2-27-q15", "type": "quiz_choice", "question": "The project was managed very ____. (Mal - Adverbio).", "options": ["badly", "bad", "worse", "worst"], "correct_answer": "badly", "explanation": "Adverbio de bad = badly (malamente / de forma deficiente)." },
        { "id": "a2-27-q16", "type": "quiz_choice", "question": "Please speak ____. I am trying to focus. (Silenciosamente).", "options": ["quietly", "quiet", "quieter", "quieting"], "correct_answer": "quietly", "explanation": "Adverbio de quiet = quietly." },
        { "id": "a2-27-q17", "type": "quiz_choice", "question": "I am a ____ learner. (Adjetivo - lento).", "options": ["slow", "slowly", "slower", "slowness"], "correct_answer": "slow", "explanation": "Adjetivo = slow." },
        { "id": "a2-27-q18", "type": "quiz_choice", "question": "Please speak more ____. (Lentamente).", "options": ["slowly", "slow", "slower", "slowness"], "correct_answer": "slowly", "explanation": "Adverbio = slowly." },
        { "id": "a2-27-q19", "type": "quiz_choice", "question": "You arrived ____ to the meeting. (Tarde - Adverbio).", "options": ["late", "lately", "later", "latest"], "correct_answer": "late", "explanation": "El adverbio de late es late (lately significa 'últimamente')." },
        { "id": "a2-27-q20", "type": "quiz_choice", "question": "We finished the project ____. (Temprano).", "options": ["early", "earlier", "earlies", "earlyly"], "correct_answer": "early", "explanation": "El adverbio de early es early (no cambia)." }
      ]
    },
