        { "id": "a1-98-q1", "type": "quiz_choice", "question": "I would like to ____ a table for four. (Reservar).", "options": ["book", "take", "get", "make"], "correct_answer": "book", "explanation": "Book a table = reservar una mesa." },
        { "id": "a1-98-q2", "type": "quiz_choice", "question": "Can I see the ____? (Menú).", "options": ["menu", "bill", "card", "list"], "correct_answer": "menu", "explanation": "Menu = menú / carta." },
        { "id": "a1-98-q3", "type": "quiz_choice", "question": "I would like the grilled ____. (Salmón a la plancha).", "options": ["salmon", "salad", "chicken", "steak"], "correct_answer": "salmon", "explanation": "Grilled salmon = salmón a la plancha." },
        { "id": "a1-98-q4", "type": "quiz_choice", "question": "Are you ready to ____? (Pedir/Ordenar).", "options": ["order", "eat", "pay", "choose"], "correct_answer": "order", "explanation": "Order = pedir / ordenar." },
        { "id": "a1-98-q5", "type": "quiz_choice", "question": "The ____, please. (La cuenta).", "options": ["bill", "check", "invoice", "receipt"], "correct_answer": "bill", "explanation": "The bill = la cuenta (en UK). 'Check' en US." },
        { "id": "a1-98-q6", "type": "quiz_choice", "question": "Could we ____ the bill? (Dividir).", "options": ["split", "divide", "share", "separate"], "correct_answer": "split", "explanation": "Split the bill = dividir la cuenta." },
        { "id": "a1-98-q7", "type": "quiz_choice", "question": "It is on ____. (Lo pago yo / Es mi invitación).", "options": ["me", "my account", "the company", "us"], "correct_answer": "me", "explanation": "It's on me = yo invito." },
        { "id": "a1-98-q8", "type": "quiz_choice", "question": "What is the ____? (Especialidad del día).", "options": ["special", "menu", "dish", "meal"], "correct_answer": "special", "explanation": "The special = el especial del día." },
        { "id": "a1-98-q9", "type": "quiz_choice", "question": "I am a ____. I don't eat meat. (Vegetariano).", "options": ["vegetarian", "vegan", "allergic", "kosher"], "correct_answer": "vegetarian", "explanation": "Vegetarian = vegetariano." },
        { "id": "a1-98-q10", "type": "quiz_choice", "question": "Could I have some ____, please? (Agua).", "options": ["water", "wine", "coffee", "juice"], "correct_answer": "water", "explanation": "Water = agua." },
        { "id": "a1-98-q11", "type": "quiz_choice", "question": "I am ____ to nuts. (Alérgico).", "options": ["allergic", "sensitive", "reacting", "against"], "correct_answer": "allergic", "explanation": "Allergic to nuts = alérgico a los frutos secos." },
        { "id": "a1-98-q12", "type": "quiz_choice", "question": "This is ____. (Delicioso).", "options": ["delicious", "tasty", "good", "fine"], "correct_answer": "delicious", "explanation": "Delicious = delicioso." },
        { "id": "a1-98-q13", "type": "quiz_choice", "question": "Could I have the ____ without onion? (Ensalada sin cebolla).", "options": ["salad", "soup", "dish", "starter"], "correct_answer": "salad", "explanation": "Salad without onion = ensalada sin cebolla." },
        { "id": "a1-98-q14", "type": "quiz_choice", "question": "For ____, I will have the cheesecake. (Postre).", "options": ["dessert", "starter", "main", "appetizer"], "correct_answer": "dessert", "explanation": "Dessert = postre." },
        { "id": "a1-98-q15", "type": "quiz_choice", "question": "As a ____, I would like soup. (Entrada).", "options": ["starter", "dessert", "main course", "side"], "correct_answer": "starter", "explanation": "Starter = entrada / primer plato." },
        { "id": "a1-98-q16", "type": "quiz_choice", "question": "Could I have the ____ course? (Plato principal).", "options": ["main", "first", "second", "last"], "correct_answer": "main", "explanation": "Main course = plato principal." },
        { "id": "a1-98-q17", "type": "quiz_choice", "question": "I would like my steak ____. (Bien cocida).", "options": ["well done", "medium", "rare", "raw"], "correct_answer": "well done", "explanation": "Well done = bien cocida." },
        { "id": "a1-98-q18", "type": "quiz_choice", "question": "Excuse me, this is not what I ____. (Pedí).", "options": ["ordered", "wanted", "asked", "chose"], "correct_answer": "ordered", "explanation": "I ordered = yo pedí." },
        { "id": "a1-98-q19", "type": "quiz_choice", "question": "The service was ____. (Excelente).", "options": ["excellent", "good", "fine", "nice"], "correct_answer": "excellent", "explanation": "Excellent service = servicio excelente." },
