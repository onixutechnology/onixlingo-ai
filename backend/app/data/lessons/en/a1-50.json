        { "id": "a1-50-q15", "type": "quiz_choice", "question": "Can we get extra ____? (servilletas).", "options": ["napkins", "papers", "towels", "wipes"], "correct_answer": "napkins", "explanation": "Servilletas (napkins)." },
        { "id": "a1-50-q16", "type": "quiz_choice", "question": "I'd like my steak ____ (bien cocido).", "options": ["well done", "good", "well", "done"], "correct_answer": "well done", "explanation": "Bien cocido (well done)." },
