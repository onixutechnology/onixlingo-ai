        { "id": "a2-34-q10", "type": "quiz_choice", "question": "I am not experienced ____ for this position. (Lo suficientemente experimentado).", "options": ["enough", "too", "much", "very"], "correct_answer": "enough", "explanation": "Después de adjetivo (experienced) = enough." },
        { "id": "a2-34-q11", "type": "quiz_choice", "question": "The deadline is ____ close. We need an extension. (Demasiado).", "options": ["too", "enough", "much", "very"], "correct_answer": "too", "explanation": "Antes de adjetivo (close) = too." },
        { "id": "a2-34-q12", "type": "quiz_choice", "question": "We don't have ____ information to make a decision. (Suficiente).", "options": ["enough", "too", "very", "much"], "correct_answer": "enough", "explanation": "Antes de sustantivo (information) = enough." },
        { "id": "a2-34-q13", "type": "quiz_choice", "question": "He is not professional ____. (Lo suficientemente profesional).", "options": ["enough", "too", "much", "very"], "correct_answer": "enough", "explanation": "Después del adjetivo = enough." },
        { "id": "a2-34-q14", "type": "quiz_choice", "question": "The printer is ____ slow. (Demasiado).", "options": ["too", "enough", "much", "very"], "correct_answer": "too", "explanation": "Antes del adjetivo = too." },
        { "id": "a2-34-q15", "type": "quiz_choice", "question": "Did you buy ____ paper? (Suficiente).", "options": ["enough", "too", "much", "many"], "correct_answer": "enough", "explanation": "Antes de sustantivo = enough." },
        { "id": "a2-34-q16", "type": "quiz_choice", "question": "There are ____ many mistakes in this report. (Demasiados).", "options": ["too", "enough", "very", "much"], "correct_answer": "too", "explanation": "Too many mistakes = demasiados errores." },
        { "id": "a2-34-q17", "type": "quiz_choice", "question": "I didn't sleep ____ last night. (Suficiente).", "options": ["enough", "too", "much", "many"], "correct_answer": "enough", "explanation": "Como adverbio al final de frase = enough." },
        { "id": "a2-34-q18", "type": "quiz_choice", "question": "The CEO's speech was ____ long. (Demasiado largo).", "options": ["too", "enough", "much", "very"], "correct_answer": "too", "explanation": "Antes del adjetivo = too." },
        { "id": "a2-34-q19", "type": "quiz_choice", "question": "Is the budget large ____? (Lo suficientemente grande).", "options": ["enough", "too", "much", "very"], "correct_answer": "enough", "explanation": "Después del adjetivo = enough." },
