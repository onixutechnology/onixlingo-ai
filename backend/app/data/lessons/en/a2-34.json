      "questions": [
        { "id": "a2-34-q1", "type": "quiz_choice", "question": "This software is ____ complicated. I don't understand it. (Demasiado).", "options": ["too", "enough", "very", "much"], "correct_answer": "too", "explanation": "Antes de adjetivo = too (demasiado)." },
        { "id": "a2-34-q2", "type": "quiz_choice", "question": "We don't have ____ money for this project. (Suficiente).", "options": ["enough", "too", "many", "very"], "correct_answer": "enough", "explanation": "Antes de sustantivo (money) = enough." },
        { "id": "a2-34-q3", "type": "quiz_choice", "question": "The meeting room is not big ____ for 20 people. (Lo suficientemente grande).", "options": ["enough", "too", "much", "very"], "correct_answer": "enough", "explanation": "Después de adjetivo (big) = enough." },
        { "id": "a2-34-q4", "type": "quiz_choice", "question": "He speaks ____ fast. I can't follow him. (Demasiado rápido).", "options": ["too", "enough", "many", "a lot"], "correct_answer": "too", "explanation": "Antes de adverbio (fast) = too." },
        { "id": "a2-34-q5", "type": "quiz_choice", "question": "Do we have ____ chairs for everyone? (Suficientes).", "options": ["enough", "too", "much", "too much"], "correct_answer": "enough", "explanation": "Antes de sustantivo (chairs) = enough." },
