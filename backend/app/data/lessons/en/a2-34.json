        { "id": "a2-34-q7", "type": "quiz_choice", "question": "Is the coffee hot ____ for you? (Lo suficientemente caliente).", "options": ["enough", "too", "much", "very"], "correct_answer": "enough", "explanation": "Después de adjetivo (hot) = enough." },
        { "id": "a2-34-q8", "type": "quiz_choice", "question": "We have ____ many meetings today. (Demasiadas).", "options": ["too", "enough", "very", "a lot"], "correct_answer": "too", "explanation": "Too many = demasiados (para contables)." },
