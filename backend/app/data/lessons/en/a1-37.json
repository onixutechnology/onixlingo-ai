        { "id": "a1-37-q13", "type": "quiz_choice", "question": "My phone ____ a lot of memory.", "options": ["has", "is having", "have", "having"], "correct_answer": "has", "explanation": "Posesión es un estado, no usa -ing (usualmente)." },
        { "id": "a1-37-q14", "type": "quiz_choice", "question": "I ____ a lot of fun at this office party.", "options": ["am having", "have", "having", "has"], "correct_answer": "am having", "explanation": "Experimentando algo ahora mismo." },
        { "id": "a1-37-q15", "type": "quiz_choice", "question": "____ you like your job?", "options": ["Do", "Are", "Is", "Does"], "correct_answer": "Do", "explanation": "Gustos y preferencias usan Presente Simple." },
