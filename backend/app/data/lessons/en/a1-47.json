        { "id": "a1-47-q1", "type": "quiz_choice", "question": "He works 10 hours a day. He is ____.", "options": ["hardworking", "lazy", "funny", "shy"], "correct_answer": "hardworking", "explanation": "Trabajador (hardworking)." },
        { "id": "a1-47-q2", "type": "quiz_choice", "question": "She never says 'please'. She is ____.", "options": ["impolite", "polite", "friendly", "kind"], "correct_answer": "impolite", "explanation": "Descortés (impolite/rude)." },
        { "id": "a1-47-q3", "type": "quiz_choice", "question": "He always says 'thank you'. He is very ____.", "options": ["polite", "impolite", "rude", "bad"], "correct_answer": "polite", "explanation": "Educado / cortés (polite)." },
        { "id": "a1-47-q4", "type": "quiz_choice", "question": "My new coworker is very ____. He talks to everyone.", "options": ["friendly", "shy", "quiet", "rude"], "correct_answer": "friendly", "explanation": "Amigable (friendly)." },
        { "id": "a1-47-q5", "type": "quiz_choice", "question": "She doesn't like to speak in public. She is ____.", "options": ["shy", "loud", "funny", "outgoing"], "correct_answer": "shy", "explanation": "Tímida (shy)." },
        { "id": "a1-47-q6", "type": "quiz_choice", "question": "He makes everyone laugh. He is ____.", "options": ["funny", "serious", "sad", "quiet"], "correct_answer": "funny", "explanation": "Gracioso (funny)." },
        { "id": "a1-47-q7", "type": "quiz_choice", "question": "The boss is very ____ during meetings. No jokes.", "options": ["serious", "funny", "lazy", "happy"], "correct_answer": "serious", "explanation": "Serio (serious)." },
        { "id": "a1-47-q8", "type": "quiz_choice", "question": "They don't like to work. They are ____.", "options": ["lazy", "hardworking", "active", "busy"], "correct_answer": "lazy", "explanation": "Perezosos (lazy)." },
        { "id": "a1-47-q9", "type": "quiz_choice", "question": "She always helps me. She is very ____.", "options": ["helpful", "lazy", "mean", "rude"], "correct_answer": "helpful", "explanation": "Servicial (helpful)." },
        { "id": "a1-47-q10", "type": "quiz_choice", "question": "What is the new manager ____?", "options": ["like", "look", "love", "doing"], "correct_answer": "like", "explanation": "¿Cómo es? (What is he like?)." },
        { "id": "a1-47-q11", "type": "quiz_choice", "question": "He is very ____ (inteligente).", "options": ["smart", "stupid", "lazy", "slow"], "correct_answer": "smart", "explanation": "Inteligente (smart o intelligent)." },
        { "id": "a1-47-q12", "type": "quiz_choice", "question": "She is ____ and organized.", "options": ["responsible", "lazy", "late", "messy"], "correct_answer": "responsible", "explanation": "Responsable (responsible)." },
        { "id": "a1-47-q13", "type": "quiz_choice", "question": "He is always late. He is ____.", "options": ["irresponsible", "responsible", "early", "smart"], "correct_answer": "irresponsible", "explanation": "Irresponsable (irresponsible)." },
        { "id": "a1-47-q14", "type": "quiz_choice", "question": "She never panics. She is very ____.", "options": ["calm", "nervous", "angry", "loud"], "correct_answer": "calm", "explanation": "Tranquila/calmada (calm)." },
        { "id": "a1-47-q15", "type": "quiz_choice", "question": "He gets angry quickly. He is ____.", "options": ["impatient", "patient", "calm", "happy"], "correct_answer": "impatient", "explanation": "Impaciente (impatient)." },
        { "id": "a1-47-q16", "type": "quiz_choice", "question": "A good leader is ____.", "options": ["confident", "shy", "nervous", "scared"], "correct_answer": "confident", "explanation": "Seguro de sí mismo (confident)." },
        { "id": "a1-47-q17", "type": "quiz_choice", "question": "She is ____. She talks a lot.", "options": ["talkative", "quiet", "shy", "silent"], "correct_answer": "talkative", "explanation": "Hablador/a (talkative)." },
        { "id": "a1-47-q18", "type": "quiz_choice", "question": "He is very ____. He doesn't say much.", "options": ["quiet", "loud", "talkative", "crazy"], "correct_answer": "quiet", "explanation": "Callado (quiet)." },
        { "id": "a1-47-q19", "type": "quiz_choice", "question": "She is ____ (amable).", "options": ["kind", "mean", "rude", "bad"], "correct_answer": "kind", "explanation": "Amable/bondadoso (kind)." },
