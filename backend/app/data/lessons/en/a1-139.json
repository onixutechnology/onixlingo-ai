    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la palabra correcta para completar la frase de presentación.",
      "questions": [
        { "id": "a1-139-q1", "type": "quiz_choice", "question": "Good morning and ____ everyone. (Bienvenidos).", "options": ["welcome", "hello", "greet", "salute"], "correct_answer": "welcome", "explanation": "Welcome everyone = bienvenidos todos." },
        { "id": "a1-139-q2", "type": "quiz_choice", "question": "Thank you for ____ today. (Venir).", "options": ["coming", "come", "to come", "came"], "correct_answer": "coming", "explanation": "Después de una preposición (for) el verbo va con -ing: for coming." },
        { "id": "a1-139-q3", "type": "quiz_choice", "question": "Let's ____ started. (Empecemos).", "options": ["get", "go", "make", "do"], "correct_answer": "get", "explanation": "Let's get started = empecemos." },
        { "id": "a1-139-q4", "type": "quiz_choice", "question": "Today, I'm going to ____ about our new product. (Hablar).", "options": ["talk", "say", "tell", "discuss"], "correct_answer": "talk", "explanation": "Talk about = hablar acerca de." },
        { "id": "a1-139-q5", "type": "quiz_choice", "question": "As you can see on the ____... (Diapositiva).", "options": ["slide", "paper", "photo", "board"], "correct_answer": "slide", "explanation": "Slide = diapositiva (en PowerPoint, por ejemplo)." },
        { "id": "a1-139-q6", "type": "quiz_choice", "question": "Please look at this ____. (Gráfico).", "options": ["chart", "charting", "line", "color"], "correct_answer": "chart", "explanation": "Chart / Graph = gráfico." },
        { "id": "a1-139-q7", "type": "quiz_choice", "question": "My ____ has three parts. (Presentación).", "options": ["presentation", "speak", "talkings", "show"], "correct_answer": "presentation", "explanation": "Presentation." },
        { "id": "a1-139-q8", "type": "quiz_choice", "question": "First, I will ____ the problem. (Explicar).", "options": ["explain", "say", "talk", "listen"], "correct_answer": "explain", "explanation": "Explain = explicar." },
        { "id": "a1-139-q9", "type": "quiz_choice", "question": "Now, let's move ____ to the next point. (Pasar a).", "options": ["on", "in", "to", "at"], "correct_answer": "on", "explanation": "Move on to = avanzar/pasar al siguiente punto." },
        { "id": "a1-139-q10", "type": "quiz_choice", "question": "In ____, sales increased by 10%. (En conclusión).", "options": ["conclusion", "ending", "finish", "final"], "correct_answer": "conclusion", "explanation": "In conclusion = para concluir." },
        { "id": "a1-139-q11", "type": "quiz_choice", "question": "To ____ up, this was a good year. (Para resumir).", "options": ["sum", "add", "make", "take"], "correct_answer": "sum", "explanation": "To sum up = para resumir / sumarizando." },
        { "id": "a1-139-q12", "type": "quiz_choice", "question": "That brings me to the ____ of my presentation. (Final).", "options": ["end", "stop", "finish", "closing"], "correct_answer": "end", "explanation": "The end of my presentation = el final de mi presentación." },
        { "id": "a1-139-q13", "type": "quiz_choice", "question": "Are there ____ questions? (¿Hay alguna?).", "options": ["any", "some", "a", "much"], "correct_answer": "any", "explanation": "En preguntas usamos 'any' (¿alguna?)." },
        { "id": "a1-139-q14", "type": "quiz_choice", "question": "I would be happy to ____ your questions. (Responder).", "options": ["answer", "say", "talk", "reply"], "correct_answer": "answer", "explanation": "Answer questions = responder preguntas." },
        { "id": "a1-139-q15", "type": "quiz_choice", "question": "Thank you for your ____. (Atención).", "options": ["attention", "listening", "ears", "looking"], "correct_answer": "attention", "explanation": "Thank you for your attention." },
        { "id": "a1-139-q16", "type": "quiz_choice", "question": "Let me ____ myself. I am John. (Presentarme).", "options": ["introduce", "present", "show", "tell"], "correct_answer": "introduce", "explanation": "Introduce myself = presentarme (a mí mismo). 'Present' se usa para un tema, no para personas." },
        { "id": "a1-139-q17", "type": "quiz_choice", "question": "The ____ of this meeting is to review the budget. (Propósito/Objetivo).", "options": ["purpose", "idea", "thing", "want"], "correct_answer": "purpose", "explanation": "Purpose = propósito u objetivo." },
        { "id": "a1-139-q18", "type": "quiz_choice", "question": "I'll keep this ____. (Breve).", "options": ["brief", "shortly", "small", "little"], "correct_answer": "brief", "explanation": "Keep this brief = mantener esto breve." },
        { "id": "a1-139-q19", "type": "quiz_choice", "question": "Feel ____ to ask questions at any time. (Siéntanse libres).", "options": ["free", "good", "happy", "ok"], "correct_answer": "free", "explanation": "Feel free to = siéntanse con la libertad de." },
        { "id": "a1-139-q20", "type": "quiz_choice", "question": "Let's look at the next ____. (Diapositiva).", "options": ["slide", "page", "sheet", "image"], "correct_answer": "slide", "explanation": "Slide = diapositiva." }
      ]
    },
