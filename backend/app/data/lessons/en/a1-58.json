        { "id": "a1-58-q15", "type": "quiz_choice", "question": "Do not use the ____ in a fire (ascensor).", "options": ["elevator", "stairs", "door", "window"], "correct_answer": "elevator", "explanation": "Ascensor / Elevador (elevator)." },
