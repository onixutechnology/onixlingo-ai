        { "id": "a1-75-q1", "type": "quiz_choice", "question": "Are you ____ on Friday? (libre).", "options": ["free", "busy", "empty", "open"], "correct_answer": "free", "explanation": "¿Estás libre? (Are you free?)." },
        { "id": "a1-75-q2", "type": "quiz_choice", "question": "Let's ____ at 10 AM (reunirnos).", "options": ["meet", "see", "look", "talk"], "correct_answer": "meet", "explanation": "Reunámonos (Let's meet)." },
        { "id": "a1-75-q3", "type": "quiz_choice", "question": "Yes, that ____ for me (me viene bien).", "options": ["works", "does", "makes", "goes"], "correct_answer": "works", "explanation": "Eso me funciona / me viene bien (That works for me)." },
        { "id": "a1-75-q4", "type": "quiz_choice", "question": "Sorry, I am ____ (ocupado).", "options": ["busy", "free", "working", "bad"], "correct_answer": "busy", "explanation": "Ocupado (busy)." },
        { "id": "a1-75-q5", "type": "quiz_choice", "question": "What ____ is good for you? (hora).", "options": ["time", "hour", "clock", "day"], "correct_answer": "time", "explanation": "¿Qué hora? (What time?)." },
        { "id": "a1-75-q6", "type": "quiz_choice", "question": "____ about 2 PM? (¿Qué tal...?).", "options": ["How", "What", "When", "Why"], "correct_answer": "How", "explanation": "¿Qué tal a las...? (How about...?)." },
