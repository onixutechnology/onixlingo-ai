        { "id": "a1-75-q11", "type": "quiz_choice", "question": "That sounds ____ (suena bien).", "options": ["good", "well", "fine", "nice"], "correct_answer": "good", "explanation": "Suena bien (That sounds good)." },
        { "id": "a1-75-q12", "type": "quiz_choice", "question": "I can't ____ it at 4 PM (no puedo llegar/asistir).", "options": ["make", "do", "have", "be"], "correct_answer": "make", "explanation": "Lograr asistir a una cita (make it)." },
        { "id": "a1-75-q13", "type": "quiz_choice", "question": "Can we ____ the meeting? (reprogramar).", "options": ["reschedule", "change", "move", "make"], "correct_answer": "reschedule", "explanation": "Reprogramar (reschedule)." },
        { "id": "a1-75-q14", "type": "quiz_choice", "question": "Let's schedule a ____ (llamada).", "options": ["call", "phone", "talk", "speak"], "correct_answer": "call", "explanation": "Llamada (call)." },
        { "id": "a1-75-q15", "type": "quiz_choice", "question": "I am ____ on Thursday (ocupado con reuniones).", "options": ["booked", "busy", "taken", "full"], "correct_answer": "booked", "explanation": "Agenda llena/reservado (booked)." },
        { "id": "a1-75-q16", "type": "quiz_choice", "question": "Is 10 AM ____ for you? (conveniente/bien).", "options": ["okay", "good", "fine", "well"], "correct_answer": "okay", "explanation": "¿Está bien? (Is it okay?)." },
