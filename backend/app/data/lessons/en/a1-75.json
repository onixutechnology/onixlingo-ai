        { "id": "a1-75-q18", "type": "quiz_choice", "question": "Let's catch ____ next week (ponernos al día/vernos).", "options": ["up", "on", "in", "out"], "correct_answer": "up", "explanation": "Ponerse al día (catch up)." },
        { "id": "a1-75-q19", "type": "quiz_choice", "question": "Send me an ____ (invitación).", "options": ["invite", "invitation", "email", "meeting"], "correct_answer": "invite", "explanation": "Invitación de calendario (invite)." },
