        { "id": "a1-82-q8", "type": "quiz_choice", "question": "Could you ____ the document? (Imprimir).", "options": ["print", "to print", "printing", "prints"], "correct_answer": "print", "explanation": "Infinitivo sin 'to' tras could." },
        { "id": "a1-82-q9", "type": "quiz_choice", "question": "Can you ____ back later? (Llamar).", "options": ["call", "to call", "calling", "calls"], "correct_answer": "call", "explanation": "Infinitivo sin 'to' tras can." },
        { "id": "a1-82-q10", "type": "quiz_choice", "question": "Could you ____ the door, please? (Cerrar).", "options": ["close", "to close", "closing", "closes"], "correct_answer": "close", "explanation": "Infinitivo sin 'to' tras could." },
        { "id": "a1-82-q11", "type": "quiz_choice", "question": "Of ____. (Respuesta afirmativa: Por supuesto).", "options": ["course", "courses", "sure", "yes"], "correct_answer": "course", "explanation": "Of course = Por supuesto." },
        { "id": "a1-82-q12", "type": "quiz_choice", "question": "No ____. (Respuesta: No hay problema).", "options": ["problem", "trouble", "issue", "worry"], "correct_answer": "problem", "explanation": "No problem = No hay problema." },
        { "id": "a1-82-q13", "type": "quiz_choice", "question": "____, I can't right now. (Lo siento, no puedo).", "options": ["Sorry", "Excuse", "Pardon", "Please"], "correct_answer": "Sorry", "explanation": "Sorry, I can't = Lo siento, no puedo." },
        { "id": "a1-82-q14", "type": "quiz_choice", "question": "Can you ____? (Repetir).", "options": ["repeat", "to repeat", "repeating", "repeats"], "correct_answer": "repeat", "explanation": "Infinitivo sin 'to' tras can." },
        { "id": "a1-82-q15", "type": "quiz_choice", "question": "Could you ____ that again, please? (Decir).", "options": ["say", "tell", "speak", "talk"], "correct_answer": "say", "explanation": "Could you say that again? (¿Podría repetirlo?)." },
        { "id": "a1-82-q16", "type": "quiz_choice", "question": "Can you ____ the presentation? (Preparar).", "options": ["prepare", "to prepare", "preparing", "prepares"], "correct_answer": "prepare", "explanation": "Infinitivo sin 'to' tras can." },
        { "id": "a1-82-q17", "type": "quiz_choice", "question": "Could you ____ on time? (Llegar).", "options": ["arrive", "to arrive", "arriving", "arrives"], "correct_answer": "arrive", "explanation": "Infinitivo sin 'to' tras could." },
        { "id": "a1-82-q18", "type": "quiz_choice", "question": "Can you ____ the invoice? (Aprobar/Firmar).", "options": ["sign", "to sign", "signing", "signs"], "correct_answer": "sign", "explanation": "Infinitivo sin 'to' tras can." },
        { "id": "a1-82-q19", "type": "quiz_choice", "question": "Could you ____ the issue? (Revisar/Solucionar).", "options": ["check", "to check", "checking", "checks"], "correct_answer": "check", "explanation": "Infinitivo sin 'to' tras could." },
        { "id": "a1-82-q20", "type": "quiz_choice", "question": "Can you ____ the data? (Compartir).", "options": ["share", "to share", "sharing", "shares"], "correct_answer": "share", "explanation": "Infinitivo sin 'to' tras can." }
