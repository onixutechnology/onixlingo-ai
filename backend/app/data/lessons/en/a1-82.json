      "questions": [
        { "id": "a1-82-q1", "type": "quiz_choice", "question": "____ you send me the report? (Directo, a un compañero).", "options": ["Can", "Could", "Do", "Are"], "correct_answer": "Can", "explanation": "Petición directa informal (Can)." },
        { "id": "a1-82-q2", "type": "quiz_choice", "question": "____ you please send me the report? (Formal, a un jefe).", "options": ["Could", "Can", "Do", "Are"], "correct_answer": "Could", "explanation": "Petición formal (Could)." },
        { "id": "a1-82-q3", "type": "quiz_choice", "question": "Can you ____ this email? (Revisar).", "options": ["check", "to check", "checking", "checks"], "correct_answer": "check", "explanation": "Después de can, el verbo va en infinitivo sin 'to'." },
        { "id": "a1-82-q4", "type": "quiz_choice", "question": "Could you ____ me the file? (Enviar).", "options": ["send", "to send", "sending", "sends"], "correct_answer": "send", "explanation": "Después de could, el verbo va en infinitivo sin 'to'." },
        { "id": "a1-82-q5", "type": "quiz_choice", "question": "Can you ____ a bit louder? (Hablar).", "options": ["speak", "to speak", "speaking", "spoke"], "correct_answer": "speak", "explanation": "Infinitivo sin 'to' tras can." },
