        { "id": "a1-129-q1", "type": "quiz_choice", "question": "I need to ____ a hotel for my trip. (Reservar).", "options": ["book", "make", "take", "do"], "correct_answer": "book", "explanation": "Book = reservar." },
        { "id": "a1-129-q2", "type": "quiz_choice", "question": "My ____ is at 8:00 AM tomorrow. (Vuelo).", "options": ["flight", "fly", "flying", "plane"], "correct_answer": "flight", "explanation": "Flight = vuelo." },
        { "id": "a1-129-q3", "type": "quiz_choice", "question": "Please show your ____ ____ at the gate. (Pase de abordar).", "options": ["boarding pass", "flight ticket", "travel paper", "receipt"], "correct_answer": "boarding pass", "explanation": "Boarding pass = pase de abordar." },
        { "id": "a1-129-q4", "type": "quiz_choice", "question": "The flight is boarding at ____ 14. (Puerta de embarque).", "options": ["gate", "door", "entry", "exit"], "correct_answer": "gate", "explanation": "Gate = puerta de embarque en un aeropuerto." },
