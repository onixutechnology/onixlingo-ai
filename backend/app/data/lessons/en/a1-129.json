        { "id": "a1-129-q7", "type": "quiz_choice", "question": "The ____ time is 2:00 PM. (Llegada).", "options": ["arrival", "departure", "arriving", "leaving"], "correct_answer": "arrival", "explanation": "Arrival = llegada." },
        { "id": "a1-129-q8", "type": "quiz_choice", "question": "I am going on a ____ ____ to Berlin. (Viaje de negocios).", "options": ["business trip", "work travel", "job trip", "business journey"], "correct_answer": "business trip", "explanation": "Business trip = viaje de negocios." },
        { "id": "a1-129-q9", "type": "quiz_choice", "question": "Can I have a ____ for the taxi? (Recibo).", "options": ["receipt", "recipe", "ticket", "paper"], "correct_answer": "receipt", "explanation": "Receipt (la 'p' no suena) = recibo." },
        { "id": "a1-129-q10", "type": "quiz_choice", "question": "Please check the travel ____. (Itinerario).", "options": ["itinerary", "agenda", "list", "schedule"], "correct_answer": "itinerary", "explanation": "Itinerary = itinerario." },
