        { "id": "a1-129-q12", "type": "quiz_choice", "question": "The flight is ____ by one hour. (Retrasado).", "options": ["delayed", "cancelled", "late", "stopped"], "correct_answer": "delayed", "explanation": "Delayed = retrasado/demorado." },
        { "id": "a1-129-q13", "type": "quiz_choice", "question": "I have to ____ ____ at the hotel before 10 PM. (Registrarme/Hacer check-in).", "options": ["check in", "check out", "book", "enter"], "correct_answer": "check in", "explanation": "Check in." },
        { "id": "a1-129-q14", "type": "quiz_choice", "question": "Don't forget to ____ ____ of the hotel tomorrow morning. (Registrar salida).", "options": ["check out", "check in", "leave", "exit"], "correct_answer": "check out", "explanation": "Check out." },
        { "id": "a1-129-q15", "type": "quiz_choice", "question": "Is this a direct ____? (Vuelo).", "options": ["flight", "plane", "travel", "trip"], "correct_answer": "flight", "explanation": "Direct flight = vuelo directo." },
        { "id": "a1-129-q16", "type": "quiz_choice", "question": "I prefer an ____ seat. (Asiento de pasillo).", "options": ["aisle", "window", "middle", "front"], "correct_answer": "aisle", "explanation": "Aisle seat = asiento de pasillo (la 's' es muda)." },
        { "id": "a1-129-q17", "type": "quiz_choice", "question": "I would like a ____ seat. (Asiento de ventana).", "options": ["window", "aisle", "middle", "back"], "correct_answer": "window", "explanation": "Window seat." },
        { "id": "a1-129-q18", "type": "quiz_choice", "question": "Where is the ____ claim? (Reclamo de equipaje).", "options": ["baggage", "suitcase", "bag", "box"], "correct_answer": "baggage", "explanation": "Baggage claim (o luggage claim) = reclamo de equipaje." },
