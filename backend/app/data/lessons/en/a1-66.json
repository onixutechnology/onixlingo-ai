      "questions": [
        { "id": "a1-66-q1", "type": "quiz_choice", "question": "I am ____ to inform you about the project.", "options": ["writing", "write", "written", "wrote"], "correct_answer": "writing", "explanation": "Le escribo... (I am writing)." },
        { "id": "a1-66-q2", "type": "quiz_choice", "question": "I am writing ____ ask for a meeting.", "options": ["to", "for", "at", "in"], "correct_answer": "to", "explanation": "Escribo para... (writing to + verbo)." },
        { "id": "a1-66-q3", "type": "quiz_choice", "question": "I am writing to ____ you a question (hacer).", "options": ["ask", "make", "do", "say"], "correct_answer": "ask", "explanation": "Hacer una pregunta (ask a question)." },
        { "id": "a1-66-q4", "type": "quiz_choice", "question": "____ our meeting yesterday (Con respecto a).", "options": ["Regarding", "Looking", "Doing", "Seeing"], "correct_answer": "Regarding", "explanation": "Con respecto a (Regarding)." },
        { "id": "a1-66-q5", "type": "quiz_choice", "question": "As ____ on the phone (Como lo hablamos).", "options": ["discussed", "said", "told", "talk"], "correct_answer": "discussed", "explanation": "Como discutimos/hablamos (As discussed)." },
        { "id": "a1-66-q6", "type": "quiz_choice", "question": "Just a quick ____ (Solo un recordatorio rápido).", "options": ["reminder", "remember", "memory", "remind"], "correct_answer": "reminder", "explanation": "Recordatorio (reminder)." },
        { "id": "a1-66-q7", "type": "quiz_choice", "question": "Could you ____ send me the file? (por favor).", "options": ["please", "thanks", "kindly", "happy"], "correct_answer": "please", "explanation": "Por favor (please)." },
        { "id": "a1-66-q8", "type": "quiz_choice", "question": "Could you ____ provide an update? (amablemente/por favor).", "options": ["kindly", "happy", "good", "nice"], "correct_answer": "kindly", "explanation": "Amablemente (kindly)." },
        { "id": "a1-66-q9", "type": "quiz_choice", "question": "Please ____ the attached document (revisa).", "options": ["review", "see", "look", "watch"], "correct_answer": "review", "explanation": "Revisar (review)." },
        { "id": "a1-66-q10", "type": "quiz_choice", "question": "I am writing to ____ a meeting (programar/solicitar).", "options": ["schedule", "make", "do", "create"], "correct_answer": "schedule", "explanation": "Programar (schedule)." },
        { "id": "a1-66-q11", "type": "quiz_choice", "question": "I am writing to ____ my appointment (cancelar).", "options": ["cancel", "make", "do", "lose"], "correct_answer": "cancel", "explanation": "Cancelar (cancel)." },
        { "id": "a1-66-q12", "type": "quiz_choice", "question": "I am writing to ____ you that... (informar).", "options": ["inform", "say", "talk", "speak"], "correct_answer": "inform", "explanation": "Informar (inform)." },
        { "id": "a1-66-q13", "type": "quiz_choice", "question": "I need some ____ about the product (información).", "options": ["information", "informations", "news", "data"], "correct_answer": "information", "explanation": "Información (information). Es incontable, no lleva 's'." },
        { "id": "a1-66-q14", "type": "quiz_choice", "question": "Can we ____ tomorrow? (reunirnos).", "options": ["meet", "see", "look", "talk"], "correct_answer": "meet", "explanation": "Reunirnos (meet)." },
        { "id": "a1-66-q15", "type": "quiz_choice", "question": "Please ____ me know when you are free (hazme).", "options": ["let", "make", "do", "give"], "correct_answer": "let", "explanation": "Hazme saber (let me know)." },
        { "id": "a1-66-q16", "type": "quiz_choice", "question": "Thank you for your ____ reply (pronta).", "options": ["prompt", "fast", "quick", "early"], "correct_answer": "prompt", "explanation": "Pronta/rápida respuesta (prompt reply)." },
        { "id": "a1-66-q17", "type": "quiz_choice", "question": "I am ____ on vacation next week (fuera).", "options": ["away", "out", "off", "gone"], "correct_answer": "away", "explanation": "Fuera/Ausente (away)." },
        { "id": "a1-66-q18", "type": "quiz_choice", "question": "If you have any ____, let me know (preguntas).", "options": ["questions", "doubts", "problems", "issues"], "correct_answer": "questions", "explanation": "Preguntas (questions). En inglés no se usa 'doubts' en este contexto." },
        { "id": "a1-66-q19", "type": "quiz_choice", "question": "This email is to ____ the meeting time (confirmar).", "options": ["confirm", "say", "tell", "make"], "correct_answer": "confirm", "explanation": "Confirmar (confirm)." },
        { "id": "a1-66-q20", "type": "quiz_choice", "question": "I will get ____ to you soon (te responderé/volveré contigo).", "options": ["back", "forward", "up", "down"], "correct_answer": "back", "explanation": "Responder/volver con alguien (get back to)." }
