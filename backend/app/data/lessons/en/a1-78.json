        { "id": "a1-78-q1", "type": "quiz_choice", "question": "This printer is faster than that ____.", "options": ["one", "ones", "printer", "thing"], "correct_answer": "one", "explanation": "One reemplaza a 'printer' (singular)." },
        { "id": "a1-78-q2", "type": "quiz_choice", "question": "These computers are better than the old ____.", "options": ["ones", "one", "computer", "things"], "correct_answer": "ones", "explanation": "Ones reemplaza a 'computers' (plural)." },
        { "id": "a1-78-q3", "type": "quiz_choice", "question": "My desk is ____ than yours (más grande).", "options": ["bigger", "big", "more big", "biger"], "correct_answer": "bigger", "explanation": "Big -> bigger." },
