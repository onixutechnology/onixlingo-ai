        { "id": "a1-78-q5", "type": "quiz_choice", "question": "The new software is ____ than the old one (más rápido).", "options": ["faster", "fast", "fastest", "more fast"], "correct_answer": "faster", "explanation": "Fast -> faster." },
        { "id": "a1-78-q6", "type": "quiz_choice", "question": "Your phone is ____ than my phone (más nuevo).", "options": ["newer", "new", "more new", "newest"], "correct_answer": "newer", "explanation": "New -> newer." },
        { "id": "a1-78-q7", "type": "quiz_choice", "question": "This office is ____ than our old office (más pequeña).", "options": ["smaller", "small", "more small", "smallest"], "correct_answer": "smaller", "explanation": "Small -> smaller." },
        { "id": "a1-78-q8", "type": "quiz_choice", "question": "These files are ____ than those ones (más pesados).", "options": ["heavier", "heavy", "more heavy", "heavyer"], "correct_answer": "heavier", "explanation": "Heavy -> heavier (y cambia a i)." },
        { "id": "a1-78-q9", "type": "quiz_choice", "question": "The internet connection is ____ today (peor).", "options": ["worse", "bad", "badder", "more bad"], "correct_answer": "worse", "explanation": "Bad -> worse." },
        { "id": "a1-78-q10", "type": "quiz_choice", "question": "Our new copy machine is ____ (mejor).", "options": ["better", "good", "gooder", "best"], "correct_answer": "better", "explanation": "Good -> better." },
        { "id": "a1-78-q11", "type": "quiz_choice", "question": "This laptop is ____ than the desktop computer (más ligera).", "options": ["lighter", "light", "more light", "lightest"], "correct_answer": "lighter", "explanation": "Light -> lighter." },
        { "id": "a1-78-q12", "type": "quiz_choice", "question": "The meeting room is ____ than my office (más fría).", "options": ["colder", "cold", "more cold", "coldest"], "correct_answer": "colder", "explanation": "Cold -> colder." },
        { "id": "a1-78-q13", "type": "quiz_choice", "question": "This keyboard is ____ than that one (más barato).", "options": ["cheaper", "cheap", "more cheap", "cheapest"], "correct_answer": "cheaper", "explanation": "Cheap -> cheaper." },
        { "id": "a1-78-q14", "type": "quiz_choice", "question": "The elevator is ____ than the stairs (más seguro).", "options": ["safer", "safe", "more safe", "safeer"], "correct_answer": "safer", "explanation": "Safe termina en 'e' -> safer." },
        { "id": "a1-78-q15", "type": "quiz_choice", "question": "Her desk is ____ than his desk (más limpio).", "options": ["cleaner", "clean", "more clean", "cleanest"], "correct_answer": "cleaner", "explanation": "Clean -> cleaner." },
        { "id": "a1-78-q16", "type": "quiz_choice", "question": "My computer is ____ today (más lenta).", "options": ["slower", "slow", "more slow", "slowest"], "correct_answer": "slower", "explanation": "Slow -> slower." },
        { "id": "a1-78-q17", "type": "quiz_choice", "question": "This mouse is ____ than the other one (peor).", "options": ["worse", "bad", "badder", "worst"], "correct_answer": "worse", "explanation": "Bad -> worse." },
        { "id": "a1-78-q18", "type": "quiz_choice", "question": "These monitors are ____ than those (más amplios/anchos).", "options": ["wider", "wide", "more wide", "widest"], "correct_answer": "wider", "explanation": "Wide -> wider." },
