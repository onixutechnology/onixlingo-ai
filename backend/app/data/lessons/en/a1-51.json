        { "id": "a1-51-q16", "type": "quiz_choice", "question": "No, I ____.", "options": ["don't", "doesn't", "do", "am not"], "correct_answer": "don't", "explanation": "Respuesta corta negativa." },
        { "id": "a1-51-q17", "type": "quiz_choice", "question": "Yes, she ____.", "options": ["does", "do", "is", "has"], "correct_answer": "does", "explanation": "Respuesta corta afirmativa (Yes, she does)." },
