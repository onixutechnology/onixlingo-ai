        { "id": "a1-27-q1", "type": "quiz_choice", "question": "I ____ arrive early to the office (100%).", "options": ["always", "never", "sometimes", "rarely"], "correct_answer": "always", "explanation": "Always es siempre (100%)." },
        { "id": "a1-27-q2", "type": "quiz_choice", "question": "She ____ drinks coffee (0%).", "options": ["never", "always", "sometimes", "often"], "correct_answer": "never", "explanation": "Never es nunca (0%)." },
