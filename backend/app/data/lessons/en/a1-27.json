        { "id": "a1-27-q10", "type": "quiz_choice", "question": "We ____ eat lunch at our desks.", "options": ["often", "neverly", "alwaysly", "some"], "correct_answer": "often", "explanation": "A menudo." },
        { "id": "a1-27-q11", "type": "quiz_choice", "question": "She ____ finishes her work on time.", "options": ["always", "always is", "is always", "always do"], "correct_answer": "always", "explanation": "Va antes del verbo principal (finishes)." },
        { "id": "a1-27-q12", "type": "quiz_choice", "question": "I am ____ tired after work.", "options": ["always", "always am", "always be", "always do"], "correct_answer": "always", "explanation": "Después del verbo To Be (am)." },
        { "id": "a1-27-q13", "type": "quiz_choice", "question": "____ you usually take the bus?", "options": ["Do", "Does", "Are", "Is"], "correct_answer": "Do", "explanation": "Auxiliar interrogativo 'Do'." },
        { "id": "a1-27-q14", "type": "quiz_choice", "question": "He ____ works on Sundays.", "options": ["never", "not never", "doesn't never", "neverly"], "correct_answer": "never", "explanation": "'Never' ya es negativo, no usamos auxiliar." },
        { "id": "a1-27-q15", "type": "quiz_choice", "question": "My computer ____ crashes.", "options": ["sometimes", "sometime", "sometimes is", "some"], "correct_answer": "sometimes", "explanation": "A veces." },
        { "id": "a1-27-q16", "type": "quiz_choice", "question": "We ____ start at 8 AM.", "options": ["always", "always are", "are always", "always do"], "correct_answer": "always", "explanation": "Siempre empezamos." },
        { "id": "a1-27-q17", "type": "quiz_choice", "question": "Does she ____ reply late?", "options": ["often", "oftenly", "often does", "do often"], "correct_answer": "often", "explanation": "¿Responde tarde a menudo?" },
        { "id": "a1-27-q18", "type": "quiz_choice", "question": "I ____ drink tea in the morning.", "options": ["never", "neverly", "no ever", "ever"], "correct_answer": "never", "explanation": "Nunca bebo té." },
        { "id": "a1-27-q19", "type": "quiz_choice", "question": "They are ____ helpful.", "options": ["always", "always are", "always do", "do always"], "correct_answer": "always", "explanation": "Siempre son útiles (después de 'are')." },
