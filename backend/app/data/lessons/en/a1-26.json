        { "id": "a1-26-q14", "type": "quiz_choice", "question": "The system ____ automatically.", "options": ["updates", "update", "updating", "updated"], "correct_answer": "updates", "explanation": "System es 'It', agregamos 's'." },
        { "id": "a1-26-q15", "type": "quiz_choice", "question": "I ____ lunch at noon.", "options": ["eat", "eats", "eating", "ate"], "correct_answer": "eat", "explanation": "Forma base." },
        { "id": "a1-26-q16", "type": "quiz_choice", "question": "He ____ clients every afternoon.", "options": ["calls", "call", "calling", "called"], "correct_answer": "calls", "explanation": "Agregamos 's'." },
