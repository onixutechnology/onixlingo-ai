        { "id": "a1-26-q1", "type": "quiz_choice", "question": "I ____ work at 9 AM every day.", "options": ["start", "starts", "starting", "started"], "correct_answer": "start", "explanation": "Con 'I' el verbo va en forma base." },
        { "id": "a1-26-q2", "type": "quiz_choice", "question": "She ____ emails in the morning.", "options": ["writes", "write", "writing", "wrote"], "correct_answer": "writes", "explanation": "Con 'she' agregamos 's' (writes)." },
