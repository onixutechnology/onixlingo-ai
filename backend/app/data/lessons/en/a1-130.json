        { "id": "a1-130-q1", "type": "quiz_choice", "question": "I ____ working at 9 AM yesterday. (Estaba).", "options": ["was", "were", "am", "did"], "correct_answer": "was", "explanation": "Past Continuous: I was working." },
        { "id": "a1-130-q2", "type": "quiz_choice", "question": "We ____ discussing the budget when the CEO entered. (Estábamos).", "options": ["were", "was", "are", "did"], "correct_answer": "were", "explanation": "We were discussing." },
        { "id": "a1-130-q3", "type": "quiz_choice", "question": "I was typing an email when the phone ____. (Sonó - interrupción).", "options": ["rang", "was ringing", "rings", "ring"], "correct_answer": "rang", "explanation": "Interrupción en Past Simple: rang." },
        { "id": "a1-130-q4", "type": "quiz_choice", "question": "The team performed very ____. (Bien).", "options": ["well", "good", "better", "goodly"], "correct_answer": "well", "explanation": "Adverbio de good = well." },
        { "id": "a1-130-q5", "type": "quiz_choice", "question": "Please reply to this email ____. (Rápidamente).", "options": ["quickly", "quick", "quicker", "fastly"], "correct_answer": "quickly", "explanation": "Adverbio: quickly." },
        { "id": "a1-130-q6", "type": "quiz_choice", "question": "The ____ is out of paper. (Impresora).", "options": ["printer", "shredder", "stapler", "folder"], "correct_answer": "printer", "explanation": "Printer = impresora." },
        { "id": "a1-130-q7", "type": "quiz_choice", "question": "Do you have any ____ for the stapler? (Grapas).", "options": ["staples", "clips", "papers", "folders"], "correct_answer": "staples", "explanation": "Staples = grapas." },
        { "id": "a1-130-q8", "type": "quiz_choice", "question": "____ the green button to start. (Presiona).", "options": ["Press", "Pressing", "To press", "Pressed"], "correct_answer": "Press", "explanation": "Imperativo: verbo base (Press)." },
        { "id": "a1-130-q9", "type": "quiz_choice", "question": "____ unplug the machine. (No desconectes).", "options": ["Don't", "Not", "No", "Doesn't"], "correct_answer": "Don't", "explanation": "Imperativo negativo: Don't + verbo." },
        { "id": "a1-130-q10", "type": "quiz_choice", "question": "I am traveling ____ Tokyo. (Hacia/Destino).", "options": ["to", "from", "into", "out of"], "correct_answer": "to", "explanation": "Destino = to." },
        { "id": "a1-130-q11", "type": "quiz_choice", "question": "She walked ____ the meeting room. (Hacia adentro).", "options": ["into", "out of", "to", "from"], "correct_answer": "into", "explanation": "Entrar = walk into." },
        { "id": "a1-130-q12", "type": "quiz_choice", "question": "I want ____ the manager. (Hablar con).", "options": ["to speak to", "speaking to", "speak to", "spoke to"], "correct_answer": "to speak to", "explanation": "Want + to + verbo." },
        { "id": "a1-130-q13", "type": "quiz_choice", "question": "We plan ____ a new product. (Lanzar).", "options": ["to launch", "launching", "launch", "launched"], "correct_answer": "to launch", "explanation": "Plan + to + verbo." },
        { "id": "a1-130-q14", "type": "quiz_choice", "question": "I enjoy ____ with this team. (Trabajar).", "options": ["working", "to work", "work", "worked"], "correct_answer": "working", "explanation": "Enjoy + verbo-ing." },
        { "id": "a1-130-q15", "type": "quiz_choice", "question": "Have you finished ____ the email? (Escribir).", "options": ["writing", "to write", "write", "wrote"], "correct_answer": "writing", "explanation": "Finish + verbo-ing." },
        { "id": "a1-130-q16", "type": "quiz_choice", "question": "My ____ is at 8 AM. (Vuelo).", "options": ["flight", "plane", "travel", "fly"], "correct_answer": "flight", "explanation": "Flight = vuelo." },
        { "id": "a1-130-q17", "type": "quiz_choice", "question": "Please show your ____ ____ at the gate. (Pase de abordar).", "options": ["boarding pass", "receipt", "itinerary", "luggage"], "correct_answer": "boarding pass", "explanation": "Boarding pass." },
        { "id": "a1-130-q18", "type": "quiz_choice", "question": "The flight is ____ by one hour. (Retrasado).", "options": ["delayed", "cancelled", "late", "stopped"], "correct_answer": "delayed", "explanation": "Delayed." },
        { "id": "a1-130-q19", "type": "quiz_choice", "question": "Use the ____ to destroy documents. (Trituradora).", "options": ["shredder", "printer", "scanner", "stapler"], "correct_answer": "shredder", "explanation": "Shredder." },
        { "id": "a1-130-q20", "type": "quiz_choice", "question": "We must avoid ____ the deadline. (Incumplir).", "options": ["missing", "to miss", "miss", "missed"], "correct_answer": "missing", "explanation": "Avoid + verbo-ing." }
