      "title": "Describiendo Tendencias (Trends)",
      "parts": [
        { "visual": "Verbos de movimiento: Go up / Increase / Rise (Subir/Aumentar). \nGo down / Decrease / Fall (Bajar/Caer). \nRemain stable (Mantenerse estable). \nFluctuate (Fluctuar/Subir y bajar).", "audio": "Verbs of movement. Go up, increase, and rise mean the same thing. Go down, decrease, and fall mean the same thing. Remain stable means no change. Fluctuate means to go up and down." },
        { "visual": "Adjetivos (Grado del cambio): Slight (Ligero). Gradual (Gradual). Sharp (Fuerte/Pronunciado). \nEjemplo: There was a slight increase in sales (Hubo un ligero aumento en las ventas). Profits fell sharply (Las ganancias cayeron fuertemente).", "audio": "Adjectives to describe the change. Slight. Gradual. Sharp. For example: There was a slight increase in sales. Or, profits fell sharply." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la palabra correcta para describir el gráfico o la tendencia.",
      "questions": [
        { "id": "a2-38-q1", "type": "quiz_choice", "question": "The chart shows that sales ____ last year. (Subieron).", "options": ["went up", "went down", "remained", "fluctuated"], "correct_answer": "went up", "explanation": "Went up = subieron (pasado de go up)." },
        { "id": "a2-38-q2", "type": "quiz_choice", "question": "Profits have started to ____. (Aumentar/Incrementar).", "options": ["increase", "decrease", "stable", "fall"], "correct_answer": "increase", "explanation": "Increase = incrementar/aumentar." },
        { "id": "a2-38-q3", "type": "quiz_choice", "question": "The prices ____ during the economic crisis. (Cayeron).", "options": ["fell", "rose", "went up", "increased"], "correct_answer": "fell", "explanation": "Fell = cayeron (pasado de fall)." },
        { "id": "a2-38-q4", "type": "quiz_choice", "question": "Unfortunately, revenue continues to ____. (Disminuir).", "options": ["decrease", "increase", "rise", "grow"], "correct_answer": "decrease", "explanation": "Decrease = disminuir." },
        { "id": "a2-38-q5", "type": "quiz_choice", "question": "The numbers didn't change. They remained ____. (Estables).", "options": ["stable", "fluctuating", "increasing", "falling"], "correct_answer": "stable", "explanation": "Remain stable = mantenerse estable (sin cambios)." },
        { "id": "a2-38-q6", "type": "quiz_choice", "question": "The value went up and down all month. It ____. (Fluctuó).", "options": ["fluctuated", "remained stable", "increased", "fell"], "correct_answer": "fluctuated", "explanation": "Fluctuate = fluctuar (subir y bajar constantemente)." },
        { "id": "a2-38-q7", "type": "quiz_choice", "question": "There was a ____ drop in sales. (Pronunciada/Fuerte).", "options": ["sharp", "slight", "stable", "gradual"], "correct_answer": "sharp", "explanation": "Sharp = agudo/fuerte/pronunciado." },
        { "id": "a2-38-q8", "type": "quiz_choice", "question": "We saw a ____ increase of 2%. (Ligero).", "options": ["slight", "sharp", "huge", "big"], "correct_answer": "slight", "explanation": "Slight = ligero/pequeño." },
        { "id": "a2-38-q9", "type": "quiz_choice", "question": "The growth was ____ over the five years. (Gradual).", "options": ["gradual", "sharp", "sudden", "slight"], "correct_answer": "gradual", "explanation": "Gradual = paulatino/gradual." },
        { "id": "a2-38-q10", "type": "quiz_choice", "question": "Profits ____ from $1M to $2M. (Subieron/Se elevaron - Pasado de rise).", "options": ["rose", "fell", "decreased", "stable"], "correct_answer": "rose", "explanation": "Rose = subieron/se elevaron (pasado de rise)." },
        { "id": "a2-38-q11", "type": "quiz_choice", "question": "There was a sudden ____ in demand. (Aumento/Incremento - Sustantivo).", "options": ["increase", "decrease", "fall", "drop"], "correct_answer": "increase", "explanation": "A sudden increase = un aumento repentino." },
        { "id": "a2-38-q12", "type": "quiz_choice", "question": "Sales ____ sharply in November. (Cayeron/Bajaron - Pasado de fall).", "options": ["fell", "rose", "increased", "grew"], "correct_answer": "fell", "explanation": "Fell sharply = cayeron fuertemente." },
        { "id": "a2-38-q13", "type": "quiz_choice", "question": "We expect the market to ____ next year. (Crecer).", "options": ["grow", "fall", "drop", "decrease"], "correct_answer": "grow", "explanation": "Grow = crecer." },
        { "id": "a2-38-q14", "type": "quiz_choice", "question": "The company's income experienced a sharp ____. (Caída/Descenso).", "options": ["drop", "rise", "increase", "growth"], "correct_answer": "drop", "explanation": "A sharp drop = una fuerte caída." },
        { "id": "a2-38-q15", "type": "quiz_choice", "question": "The cost of materials ____ stable. (Se mantuvo - Pasado de remain).", "options": ["remained", "went", "fell", "fluctuated"], "correct_answer": "remained", "explanation": "Remained stable = se mantuvo estable." },
        { "id": "a2-38-q16", "type": "quiz_choice", "question": "There was a significant ____ in productivity. (Caída/Disminución).", "options": ["decrease", "increase", "rise", "growth"], "correct_answer": "decrease", "explanation": "A significant decrease = una disminución significativa." },
        { "id": "a2-38-q17", "type": "quiz_choice", "question": "Our numbers went ____ significantly. (Hacia arriba/Subieron).", "options": ["up", "down", "off", "out"], "correct_answer": "up", "explanation": "Go up (went up) = subir." },
        { "id": "a2-38-q18", "type": "quiz_choice", "question": "Expenses went ____ this quarter. (Hacia abajo/Bajaron).", "options": ["down", "up", "in", "out"], "correct_answer": "down", "explanation": "Go down (went down) = bajar." },
        { "id": "a2-38-q19", "type": "quiz_choice", "question": "This graph ____ our sales performance. (Muestra).", "options": ["shows", "looks", "watches", "tells"], "correct_answer": "shows", "explanation": "This graph shows = este gráfico muestra." },
        { "id": "a2-38-q20", "type": "quiz_choice", "question": "The price of oil ____ wildly last year. (Fluctuó salvajemente).", "options": ["fluctuated", "remained", "stable", "slight"], "correct_answer": "fluctuated", "explanation": "Fluctuated wildly = fluctuó salvajemente (subió y bajó sin control)." }
      ]
    },
