  "completion_message": "¡Muy bien! 'Might' es excelente para sonar profesional cuando no estás 100% seguro de algo. Ahora puedes expresar posibilidades.",
  "stages": [
    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Might (Posibilidad)",
      "parts": [
        { "visual": "Usamos 'might' para hablar de cosas que son posibles en el futuro o presente, pero no seguras (quizás/podría). I might go to the conference (Quizás vaya a la conferencia). The client might call later (El cliente podría llamar más tarde).", "audio": "We use might to talk about things that are possible in the future or present, but not certain. I might go to the conference. The client might call later." },
        { "visual": "Estructura: Sujeto + might + infinitivo. Negativo: might not (quizás no). They might not accept the offer (Quizás no acepten la oferta). No cambia con he/she/it.", "audio": "Structure: Subject plus might plus bare infinitive. Negative: might not. They might not accept the offer. The form does not change for he, she, it." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta para expresar posibilidad.",
      "questions": [
        { "id": "a1-114-q1", "type": "quiz_choice", "question": "I ____ go to the conference, I'm not sure yet. (Quizás vaya).", "options": ["might", "must", "will", "am"], "correct_answer": "might", "explanation": "Might = posibilidad (quizás)." },
        { "id": "a1-114-q2", "type": "quiz_choice", "question": "The client ____ call later. (Podría llamar).", "options": ["might", "must", "have to", "is"], "correct_answer": "might", "explanation": "Might para expresar posibilidad." },
        { "id": "a1-114-q3", "type": "quiz_choice", "question": "She might ____ late today. (Llegar).", "options": ["arrive", "arrives", "arriving", "arrived"], "correct_answer": "arrive", "explanation": "Might + infinitivo: arrive." },
        { "id": "a1-114-q4", "type": "quiz_choice", "question": "They ____ not accept the offer. (Quizás no acepten).", "options": ["might", "must", "should", "will"], "correct_answer": "might", "explanation": "Might not = quizás no." },
        { "id": "a1-114-q5", "type": "quiz_choice", "question": "It ____ rain this afternoon. (Podría llover).", "options": ["might", "must", "has", "does"], "correct_answer": "might", "explanation": "Might rain = podría llover (posibilidad)." },
        { "id": "a1-114-q6", "type": "quiz_choice", "question": "We might ____ the deadline. (Extender).", "options": ["extend", "extends", "extending", "extended"], "correct_answer": "extend", "explanation": "Might + extend." },
        { "id": "a1-114-q7", "type": "quiz_choice", "question": "He ____ not be in the office tomorrow. (Quizás no esté).", "options": ["might", "must", "is", "does"], "correct_answer": "might", "explanation": "Might not be = quizás no esté." },
        { "id": "a1-114-q8", "type": "quiz_choice", "question": "The meeting ____ finish early. (Podría terminar).", "options": ["might", "must", "has", "do"], "correct_answer": "might", "explanation": "Might finish." },
        { "id": "a1-114-q9", "type": "quiz_choice", "question": "I might ____ a coffee break soon. (Tomar).", "options": ["take", "takes", "taking", "took"], "correct_answer": "take", "explanation": "Might + take." },
        { "id": "a1-114-q10", "type": "quiz_choice", "question": "We ____ need more time for this project. (Quizás necesitemos).", "options": ["might", "must", "have", "are"], "correct_answer": "might", "explanation": "Might need = quizás necesitemos." },
        { "id": "a1-114-q11", "type": "quiz_choice", "question": "The price might ____. (Subir / Aumentar).", "options": ["go up", "goes up", "going up", "went up"], "correct_answer": "go up", "explanation": "Might + infinitivo: go up." },
        { "id": "a1-114-q12", "type": "quiz_choice", "question": "She ____ not know the answer. (Quizás no sepa).", "options": ["might", "must", "should", "does"], "correct_answer": "might", "explanation": "Might not know." },
        { "id": "a1-114-q13", "type": "quiz_choice", "question": "They might ____ the contract today. (Firmar).", "options": ["sign", "signs", "signing", "signed"], "correct_answer": "sign", "explanation": "Might + sign." },
        { "id": "a1-114-q14", "type": "quiz_choice", "question": "The software ____ crash. Save your work. (Podría fallar).", "options": ["might", "must", "should", "does"], "correct_answer": "might", "explanation": "Might crash." },
        { "id": "a1-114-q15", "type": "quiz_choice", "question": "I ____ be a little late to the meeting. (Podría llegar).", "options": ["might", "must", "am", "do"], "correct_answer": "might", "explanation": "Might be." },
        { "id": "a1-114-q16", "type": "quiz_choice", "question": "He might ____ a promotion next month. (Conseguir/Obtener).", "options": ["get", "gets", "getting", "got"], "correct_answer": "get", "explanation": "Might + get." },
        { "id": "a1-114-q17", "type": "quiz_choice", "question": "We might not ____ the budget for this. (Tener).", "options": ["have", "has", "having", "had"], "correct_answer": "have", "explanation": "Might not have." },
        { "id": "a1-114-q18", "type": "quiz_choice", "question": "The CEO ____ visit our branch next week. (Podría visitar).", "options": ["might", "must", "is", "has"], "correct_answer": "might", "explanation": "Might visit." },
        { "id": "a1-114-q19", "type": "quiz_choice", "question": "This ____ be the best option. (Podría ser).", "options": ["might", "must", "is", "are"], "correct_answer": "might", "explanation": "Might be." },
        { "id": "a1-114-q20", "type": "quiz_choice", "question": "I might ____ early on Friday. (Salir/Irme).", "options": ["leave", "leaves", "leaving", "left"], "correct_answer": "leave", "explanation": "Might + leave." }
      ]
    },
