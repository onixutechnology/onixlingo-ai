        { "id": "a1-146-q7", "type": "quiz_choice", "question": "Can you put these papers in a ____? (Carpeta).", "options": ["folder", "printer", "laptop", "mouse"], "correct_answer": "folder", "explanation": "Folder = carpeta." },
        { "id": "a1-146-q8", "type": "quiz_choice", "question": "We need to ____ a meeting for tomorrow. (Programar).", "options": ["schedule", "cancel", "attend", "write"], "correct_answer": "schedule", "explanation": "Schedule = programar." },
        { "id": "a1-146-q9", "type": "quiz_choice", "question": "Please read the ____ before the meeting. (Orden del día).", "options": ["agenda", "minutes", "attendees", "chair"], "correct_answer": "agenda", "explanation": "Agenda = orden del día / temas a tratar." },
        { "id": "a1-146-q10", "type": "quiz_choice", "question": "Who is taking the ____ today? (Minuta/Acta).", "options": ["minutes", "agenda", "notes", "seconds"], "correct_answer": "minutes", "explanation": "Take the minutes = tomar la minuta." },
