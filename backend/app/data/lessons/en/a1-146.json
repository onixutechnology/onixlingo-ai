        { "id": "a1-146-q12", "type": "quiz_choice", "question": "We must ____ the meeting because the CEO is sick. (Cancelar).", "options": ["cancel", "schedule", "attend", "start"], "correct_answer": "cancel", "explanation": "Cancel = cancelar." },
        { "id": "a1-146-q13", "type": "quiz_choice", "question": "I work in the ____ department. We sell products. (Ventas).", "options": ["Sales", "HR", "IT", "Accounting"], "correct_answer": "Sales", "explanation": "Sales = Ventas." },
        { "id": "a1-146-q14", "type": "quiz_choice", "question": "She is the ____ of the project. (Gerente/Directora).", "options": ["manager", "employee", "intern", "desk"], "correct_answer": "manager", "explanation": "Manager = gerente/líder." },
        { "id": "a1-146-q15", "type": "quiz_choice", "question": "The ____ works very hard. (Empleado).", "options": ["employee", "employer", "CEO", "manager"], "correct_answer": "employee", "explanation": "Employee = empleado. (Employer = empleador)." },
        { "id": "a1-146-q16", "type": "quiz_choice", "question": "I need a new ____ because my screen is broken. (Portátil).", "options": ["laptop", "desk", "printer", "folder"], "correct_answer": "laptop", "explanation": "Laptop = computadora portátil." },
        { "id": "a1-146-q17", "type": "quiz_choice", "question": "I will ____ the meeting tomorrow. (Asistir).", "options": ["attend", "assist", "go", "schedule"], "correct_answer": "attend", "explanation": "Attend = asistir a un evento." },
        { "id": "a1-146-q18", "type": "quiz_choice", "question": "The ____ is leading the meeting today. (Moderador).", "options": ["chair", "desk", "table", "board"], "correct_answer": "chair", "explanation": "Chair / Chairperson = moderador." },
        { "id": "a1-146-q19", "type": "quiz_choice", "question": "Our company has 500 ____. (Empleados).", "options": ["employees", "employers", "CEOs", "managers"], "correct_answer": "employees", "explanation": "Employees (plural)." },
