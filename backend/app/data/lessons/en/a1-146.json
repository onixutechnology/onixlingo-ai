        { "id": "a1-146-q1", "type": "quiz_choice", "question": "The ____ is the leader of the company. (Director Ejecutivo).", "options": ["CEO", "employee", "intern", "client"], "correct_answer": "CEO", "explanation": "CEO = Chief Executive Officer." },
        { "id": "a1-146-q2", "type": "quiz_choice", "question": "I need to talk to Human Resources, or ____. (Recursos Humanos).", "options": ["HR", "IT", "PR", "CEO"], "correct_answer": "HR", "explanation": "HR = Human Resources." },
        { "id": "a1-146-q3", "type": "quiz_choice", "question": "If your computer is broken, call the ____ department. (Sistemas).", "options": ["IT", "HR", "Sales", "Accounting"], "correct_answer": "IT", "explanation": "IT = Information Technology." },
        { "id": "a1-146-q4", "type": "quiz_choice", "question": "The ____ department deals with money and invoices. (Contabilidad).", "options": ["Accounting", "Sales", "Marketing", "HR"], "correct_answer": "Accounting", "explanation": "Accounting = Contabilidad." },
        { "id": "a1-146-q5", "type": "quiz_choice", "question": "Did you print the documents on the ____? (Impresora).", "options": ["printer", "laptop", "mouse", "desk"], "correct_answer": "printer", "explanation": "Printer = impresora." },
