      "questions": [
        { "id": "a1-86-q1", "type": "quiz_choice", "question": "I ____ in a meeting yesterday.", "options": ["was", "were", "is", "am"], "correct_answer": "was", "explanation": "I + was." },
        { "id": "a1-86-q2", "type": "quiz_choice", "question": "She ____ very busy last week.", "options": ["was", "were", "is", "be"], "correct_answer": "was", "explanation": "She + was." },
