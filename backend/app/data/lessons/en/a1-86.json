        { "id": "a1-86-q16", "type": "quiz_choice", "question": "The staff ____ informed. (negativo, plural).", "options": ["weren't", "wasn't", "don't", "aren't"], "correct_answer": "weren't", "explanation": "Staff (plural) + weren't." },
        { "id": "a1-86-q17", "type": "quiz_choice", "question": "____ the meeting productive? (Pregunta).", "options": ["Was", "Were", "Is", "Does"], "correct_answer": "Was", "explanation": "The meeting (it) -> Was?" },
