  "stages": [
    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Was / Were",
      "parts": [
        { "visual": "'Was' se usa con I, He, She, It: I was in a meeting (Estaba en una reunión). She was busy (Ella estaba ocupada).", "audio": "Was is used with I, He, She, It: I was in a meeting. She was busy." },
        { "visual": "'Were' se usa con You, We, They: You were right (Tenías razón). They were on time (Llegaron a tiempo). Negativo: wasn't / weren't. Pregunta: Was I? / Were they?", "audio": "Were is used with You, We, They: You were right. They were on time. Negative: wasn't, weren't. Question: Was I? Were they?" }
      ]
    },
    {
