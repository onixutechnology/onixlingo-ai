        { "id": "a1-86-q13", "type": "quiz_choice", "question": "The clients ____ satisfied.", "options": ["were", "was", "are", "be"], "correct_answer": "were", "explanation": "Clients (plural) + were." },
        { "id": "a1-86-q14", "type": "quiz_choice", "question": "The deadline ____ on Monday.", "options": ["was", "were", "is", "be"], "correct_answer": "was", "explanation": "The deadline (it) + was." },
