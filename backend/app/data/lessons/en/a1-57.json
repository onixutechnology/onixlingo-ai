        { "id": "a1-57-q11", "type": "quiz_choice", "question": "____ the file on your desktop (guardar).", "options": ["Save", "Saves", "Saving", "Safe"], "correct_answer": "Save", "explanation": "Guardar (save)." },
        { "id": "a1-57-q12", "type": "quiz_choice", "question": "I accidentally ____ the document (borré).", "options": ["deleted", "delete", "deleting", "clear"], "correct_answer": "deleted", "explanation": "Borré en pasado (deleted)." },
        { "id": "a1-57-q13", "type": "quiz_choice", "question": "Check your ____ connection (red).", "options": ["network", "net", "work", "cable"], "correct_answer": "network", "explanation": "Red (network)." },
