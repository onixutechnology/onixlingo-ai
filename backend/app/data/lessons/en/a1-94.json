      "questions": [
        { "id": "a1-94-q1", "type": "quiz_choice", "question": "A graph with bars is called a ____ chart.", "options": ["bar", "line", "pie", "column"], "correct_answer": "bar", "explanation": "Bar chart = gráfico de barras." },
        { "id": "a1-94-q2", "type": "quiz_choice", "question": "A graph that shows parts of a circle is a ____ chart.", "options": ["pie", "line", "bar", "area"], "correct_answer": "pie", "explanation": "Pie chart = gráfico circular." },
        { "id": "a1-94-q3", "type": "quiz_choice", "question": "Sales ____ last month. (subieron).", "options": ["went up", "went down", "stayed the same", "fell"], "correct_answer": "went up", "explanation": "Went up = subieron." },
        { "id": "a1-94-q4", "type": "quiz_choice", "question": "Costs ____ in Q3. (bajaron).", "options": ["decreased", "increased", "rose", "grew"], "correct_answer": "decreased", "explanation": "Decreased = bajaron." },
        { "id": "a1-94-q5", "type": "quiz_choice", "question": "Revenue ____ stable all year. (permaneció).", "options": ["remained", "went", "fell", "rose"], "correct_answer": "remained", "explanation": "Remained stable = permaneció estable." },
        { "id": "a1-94-q6", "type": "quiz_choice", "question": "Sales ____ a peak in December. (alcanzaron el máximo).", "options": ["reached", "hit", "got", "made"], "correct_answer": "reached", "explanation": "Reached a peak = alcanzaron el máximo." },
        { "id": "a1-94-q7", "type": "quiz_choice", "question": "The horizontal line at the bottom is the ____.", "options": ["X-axis", "Y-axis", "line", "bar"], "correct_answer": "X-axis", "explanation": "X-axis = eje horizontal." },
        { "id": "a1-94-q8", "type": "quiz_choice", "question": "The vertical line on the left is the ____.", "options": ["Y-axis", "X-axis", "column", "bar"], "correct_answer": "Y-axis", "explanation": "Y-axis = eje vertical." },
        { "id": "a1-94-q9", "type": "quiz_choice", "question": "The graph ____ an increase in Q2. (muestra).", "options": ["shows", "tell", "says", "explains"], "correct_answer": "shows", "explanation": "The graph shows = la gráfica muestra." },
        { "id": "a1-94-q10", "type": "quiz_choice", "question": "Sales ____ sharply in January. (cayeron bruscamente).", "options": ["fell", "rose", "went up", "stayed"], "correct_answer": "fell", "explanation": "Fell = cayeron (fall -> fell)." },
        { "id": "a1-94-q11", "type": "quiz_choice", "question": "The ____ shows the months of the year. (eje X).", "options": ["X-axis", "Y-axis", "legend", "title"], "correct_answer": "X-axis", "explanation": "El eje X suele mostrar el tiempo." },
        { "id": "a1-94-q12", "type": "quiz_choice", "question": "The figure ____ by 20%. (aumentó).", "options": ["rose", "fell", "stayed", "decreased"], "correct_answer": "rose", "explanation": "Rose = aumentó (rise -> rose)." },
        { "id": "a1-94-q13", "type": "quiz_choice", "question": "The chart shows a downward ____. (tendencia).", "options": ["trend", "line", "bar", "axis"], "correct_answer": "trend", "explanation": "Trend = tendencia." },
        { "id": "a1-94-q14", "type": "quiz_choice", "question": "According to the data, Q4 was the ____. (el mejor).", "options": ["best", "worst", "highest", "biggest"], "correct_answer": "best", "explanation": "The best quarter." },
        { "id": "a1-94-q15", "type": "quiz_choice", "question": "The numbers ____ from 100 to 500. (van / van de).", "options": ["range", "go", "jump", "include"], "correct_answer": "range", "explanation": "Range from X to Y = van de X a Y." },
        { "id": "a1-94-q16", "type": "quiz_choice", "question": "The key that explains the colors is the ____.", "options": ["legend", "title", "axis", "label"], "correct_answer": "legend", "explanation": "Legend = leyenda de la gráfica." },
        { "id": "a1-94-q17", "type": "quiz_choice", "question": "As you can see in this ____, sales are growing. (gráfico).", "options": ["chart", "chart", "picture", "image"], "correct_answer": "chart", "explanation": "Chart = gráfico." },
        { "id": "a1-94-q18", "type": "quiz_choice", "question": "The data ____ a clear pattern. (revela).", "options": ["reveals", "says", "tells", "shows"], "correct_answer": "reveals", "explanation": "Reveals = revela." },
        { "id": "a1-94-q19", "type": "quiz_choice", "question": "Sales ____ in February but recovered in March. (bajaron - simple).", "options": ["dropped", "drop", "dropping", "drops"], "correct_answer": "dropped", "explanation": "Dropped = cayeron (drop -> dropped)." },
        { "id": "a1-94-q20", "type": "quiz_choice", "question": "The ____ of the chart is 'Annual Sales'. (título).", "options": ["title", "legend", "axis", "label"], "correct_answer": "title", "explanation": "Title = título de la gráfica." }
      ]
