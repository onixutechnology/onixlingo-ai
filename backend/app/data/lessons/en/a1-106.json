    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Presente Perfecto",
      "parts": [
        { "visual": "Estructura: Sujeto + have/has + participio pasado. I have finished the report (He terminado el informe). She has sent the email (Ella ha enviado el email).", "audio": "Structure: Subject plus have or has plus past participle. I have finished the report. She has sent the email." },
        { "visual": "Contracciones: I've, You've, We've, They've + participio. He's, She's, It's + participio. Negativo: haven't / hasn't. Palabras clave: already (ya), just (recién), yet (aún/todavía), ever (alguna vez), never (nunca).", "audio": "Contractions: I've, You've, We've, They've. He's, She's, It's. Negative: haven't or hasn't. Key words: already, just, yet, ever, never." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta del Presente Perfecto.",
      "questions": [
        { "id": "a1-106-q1", "type": "quiz_choice", "question": "I ____ finished the report. (He terminado).", "options": ["have", "has", "had", "am"], "correct_answer": "have", "explanation": "I + have." },
        { "id": "a1-106-q2", "type": "quiz_choice", "question": "She ____ sent the email. (Ha enviado).", "options": ["has", "have", "had", "is"], "correct_answer": "has", "explanation": "She + has." },
        { "id": "a1-106-q3", "type": "quiz_choice", "question": "They ____ completed the project. (Han completado).", "options": ["have", "has", "had", "are"], "correct_answer": "have", "explanation": "They + have." },
        { "id": "a1-106-q4", "type": "quiz_choice", "question": "I have ____ the meeting. (Cancelado - cancel).", "options": ["cancelled", "cancel", "cancelling", "cancels"], "correct_answer": "cancelled", "explanation": "Participio de cancel: cancelled." },
        { "id": "a1-106-q5", "type": "quiz_choice", "question": "He has ____ the client. (Llamado - call).", "options": ["called", "call", "calling", "calls"], "correct_answer": "called", "explanation": "Participio de call: called." },
        { "id": "a1-106-q6", "type": "quiz_choice", "question": "We have ____ the contract. (Firmado - sign).", "options": ["signed", "sign", "signing", "signs"], "correct_answer": "signed", "explanation": "Participio de sign: signed." },
        { "id": "a1-106-q7", "type": "quiz_choice", "question": "I have ____ finished. (Ya terminé - already).", "options": ["already", "just", "yet", "ever"], "correct_answer": "already", "explanation": "Already = ya (en afirmaciones)." },
        { "id": "a1-106-q8", "type": "quiz_choice", "question": "She has ____ arrived. (Acaba de llegar - just).", "options": ["just", "already", "yet", "never"], "correct_answer": "just", "explanation": "Just = recién / acabar de." },
        { "id": "a1-106-q9", "type": "quiz_choice", "question": "I haven't finished ____. (Todavía no - yet).", "options": ["yet", "already", "just", "still"], "correct_answer": "yet", "explanation": "Yet = todavía (en negaciones y preguntas)." },
        { "id": "a1-106-q10", "type": "quiz_choice", "question": "Have you ____ sent the report? (Enviado - sent).", "options": ["sent", "send", "sending", "sends"], "correct_answer": "sent", "explanation": "Send -> Sent (irregular)." },
        { "id": "a1-106-q11", "type": "quiz_choice", "question": "I ____ finished. (No he terminado - negativo).", "options": ["haven't", "hasn't", "don't have", "am not"], "correct_answer": "haven't", "explanation": "I + haven't." },
        { "id": "a1-106-q12", "type": "quiz_choice", "question": "She ____ received the file yet. (No ha recibido).", "options": ["hasn't", "haven't", "didn't", "isn't"], "correct_answer": "hasn't", "explanation": "She + hasn't." },
        { "id": "a1-106-q13", "type": "quiz_choice", "question": "____ you received my email? (Pregunta).", "options": ["Have", "Has", "Did", "Do"], "correct_answer": "Have", "explanation": "Have you + participio?" },
        { "id": "a1-106-q14", "type": "quiz_choice", "question": "____ she approved the budget? (Pregunta, she).", "options": ["Has", "Have", "Did", "Is"], "correct_answer": "Has", "explanation": "Has she + participio?" },
        { "id": "a1-106-q15", "type": "quiz_choice", "question": "Yes, I ____. (Respuesta corta positiva).", "options": ["have", "has", "did", "do"], "correct_answer": "have", "explanation": "Yes, I have." },
        { "id": "a1-106-q16", "type": "quiz_choice", "question": "No, she ____. (Respuesta corta negativa, she).", "options": ["hasn't", "haven't", "didn't", "isn't"], "correct_answer": "hasn't", "explanation": "No, she hasn't." },
        { "id": "a1-106-q17", "type": "quiz_choice", "question": "I have ____ done this before. (Nunca - never).", "options": ["never", "not", "ever", "yet"], "correct_answer": "never", "explanation": "Never = nunca." },
        { "id": "a1-106-q18", "type": "quiz_choice", "question": "We have ____ received the payment. (Acaban de).", "options": ["just", "already", "never", "yet"], "correct_answer": "just", "explanation": "Just = recién." },
        { "id": "a1-106-q19", "type": "quiz_choice", "question": "I have already ____ the form. (Completado - complete).", "options": ["completed", "complete", "completing", "completes"], "correct_answer": "completed", "explanation": "Participio: completed." },
        { "id": "a1-106-q20", "type": "quiz_choice", "question": "Has he ____ the presentation? (Preparado - prepare).", "options": ["prepared", "prepare", "preparing", "prepares"], "correct_answer": "prepared", "explanation": "Participio: prepared." }
      ]
    },
