      "questions": [
        { "id": "a2-18-q1", "type": "quiz_choice", "question": "Please send your ____ to the HR department. (Currículum).", "options": ["resume", "paper", "card", "sheet"], "correct_answer": "resume", "explanation": "Resume o CV es el currículum." },
        { "id": "a2-18-q2", "type": "quiz_choice", "question": "You should write a good ____ letter to introduce yourself. (Carta de presentación).", "options": ["cover", "front", "first", "hello"], "correct_answer": "cover", "explanation": "Cover letter = carta de presentación." },
        { "id": "a2-18-q3", "type": "quiz_choice", "question": "I want to ____ for the marketing position. (Postularme).", "options": ["apply", "ask", "call", "say"], "correct_answer": "apply", "explanation": "Apply for a job = postularse a un trabajo." },
        { "id": "a2-18-q4", "type": "quiz_choice", "question": "What are your greatest ____? (Fortalezas).", "options": ["strengths", "strongs", "powers", "goods"], "correct_answer": "strengths", "explanation": "Strengths = fortalezas." },
        { "id": "a2-18-q5", "type": "quiz_choice", "question": "What is your biggest ____? (Debilidad).", "options": ["weakness", "weak", "bad", "problem"], "correct_answer": "weakness", "explanation": "Weakness = debilidad." },
        { "id": "a2-18-q6", "type": "quiz_choice", "question": "The company wants to ____ five new engineers. (Contratar).", "options": ["hire", "fire", "rent", "buy"], "correct_answer": "hire", "explanation": "Hire = contratar." },
        { "id": "a2-18-q7", "type": "quiz_choice", "question": "If you don't do your job well, they will ____ you. (Despedir).", "options": ["fire", "burn", "hire", "quit"], "correct_answer": "fire", "explanation": "Fire = despedir (de un trabajo)." },
        { "id": "a2-18-q8", "type": "quiz_choice", "question": "I filled out the job ____ online. (Solicitud).", "options": ["application", "apply", "paper", "form"], "correct_answer": "application", "explanation": "Job application = solicitud de empleo." },
        { "id": "a2-18-q9", "type": "quiz_choice", "question": "What are your technical ____? (Habilidades).", "options": ["skills", "talents", "works", "doings"], "correct_answer": "skills", "explanation": "Skills = habilidades / destrezas." },
        { "id": "a2-18-q10", "type": "quiz_choice", "question": "She has a lot of ____ in this industry. (Experiencia).", "options": ["experience", "experiences", "time", "working"], "correct_answer": "experience", "explanation": "Experience es incontable cuando significa conocimiento adquirido trabajando." },
        { "id": "a2-18-q11", "type": "quiz_choice", "question": "I have an ____ with the HR manager tomorrow. (Entrevista).", "options": ["interview", "meeting", "talk", "chat"], "correct_answer": "interview", "explanation": "Job interview = entrevista de trabajo." },
        { "id": "a2-18-q12", "type": "quiz_choice", "question": "I decided to ____ my job because I found a better one. (Renunciar).", "options": ["quit", "fire", "hire", "exit"], "correct_answer": "quit", "explanation": "Quit = renunciar." },
        { "id": "a2-18-q13", "type": "quiz_choice", "question": "We are looking for a ____ candidate. (Candidato).", "options": ["candidate", "person", "worker", "human"], "correct_answer": "candidate", "explanation": "Candidate = candidato." },
        { "id": "a2-18-q14", "type": "quiz_choice", "question": "Can you provide two professional ____? (Referencias).", "options": ["references", "friends", "contacts", "names"], "correct_answer": "references", "explanation": "References = referencias laborales." },
        { "id": "a2-18-q15", "type": "quiz_choice", "question": "What is your expected ____? (Salario).", "options": ["salary", "money", "pay", "cash"], "correct_answer": "salary", "explanation": "Salary = salario anual/mensual." },
        { "id": "a2-18-q16", "type": "quiz_choice", "question": "I am a fast ____. (Aprendiz).", "options": ["learner", "student", "reader", "thinker"], "correct_answer": "learner", "explanation": "Fast learner = persona que aprende rápido." },
        { "id": "a2-18-q17", "type": "quiz_choice", "question": "I am good at solving ____. (Problemas).", "options": ["problems", "issues", "questions", "answers"], "correct_answer": "problems", "explanation": "Solve problems = resolver problemas." },
        { "id": "a2-18-q18", "type": "quiz_choice", "question": "I work well under ____. (Presión).", "options": ["pressure", "stress", "heavy", "time"], "correct_answer": "pressure", "explanation": "Work under pressure = trabajar bajo presión." },
        { "id": "a2-18-q19", "type": "quiz_choice", "question": "We will ____ in touch. (Mantendremos el contacto).", "options": ["keep", "stay", "make", "be"], "correct_answer": "keep", "explanation": "Keep in touch / Be in touch = mantenerse en contacto." },
        { "id": "a2-18-q20", "type": "quiz_choice", "question": "Thank you for your ____. (Tiempo).", "options": ["time", "hour", "day", "visit"], "correct_answer": "time", "explanation": "Thank you for your time (al final de la entrevista)." }
      ]
