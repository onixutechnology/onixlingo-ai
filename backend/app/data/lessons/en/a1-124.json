        { "id": "a1-124-q1", "type": "quiz_choice", "question": "The ____ is out of paper. (Impresora).", "options": ["printer", "shredder", "stapler", "projector"], "correct_answer": "printer", "explanation": "Printer = impresora." },
        { "id": "a1-124-q2", "type": "quiz_choice", "question": "Use the ____ to destroy these confidential documents. (Trituradora).", "options": ["shredder", "printer", "scanner", "photocopier"], "correct_answer": "shredder", "explanation": "Shredder = trituradora de papel." },
        { "id": "a1-124-q3", "type": "quiz_choice", "question": "I need a ____ to attach these pages together. (Grapadora).", "options": ["stapler", "clip", "folder", "highlighter"], "correct_answer": "stapler", "explanation": "Stapler = grapadora." },
        { "id": "a1-124-q4", "type": "quiz_choice", "question": "Do you have any ____ for the stapler? (Grapas).", "options": ["staples", "clips", "pins", "papers"], "correct_answer": "staples", "explanation": "Staples = grapas." },
        { "id": "a1-124-q5", "type": "quiz_choice", "question": "Can I borrow your ____ to mark this text? (Resaltador).", "options": ["highlighter", "pen", "pencil", "stapler"], "correct_answer": "highlighter", "explanation": "Highlighter = resaltador." },
        { "id": "a1-124-q6", "type": "quiz_choice", "question": "Put the documents in a blue ____. (Carpeta).", "options": ["folder", "clip", "note", "paper"], "correct_answer": "folder", "explanation": "Folder = carpeta." },
        { "id": "a1-124-q7", "type": "quiz_choice", "question": "We need the ____ for the presentation. (Proyector).", "options": ["projector", "printer", "shredder", "scanner"], "correct_answer": "projector", "explanation": "Projector = proyector." },
        { "id": "a1-124-q8", "type": "quiz_choice", "question": "Please make 10 copies on the ____. (Fotocopiadora).", "options": ["photocopier", "printer", "scanner", "shredder"], "correct_answer": "photocopier", "explanation": "Photocopier (o copier) = fotocopiadora." },
        { "id": "a1-124-q9", "type": "quiz_choice", "question": "Use a ____ to hold these two pages. (Clip de papel).", "options": ["paper clip", "stapler", "folder", "sticky note"], "correct_answer": "paper clip", "explanation": "Paper clip = clip." },
        { "id": "a1-124-q10", "type": "quiz_choice", "question": "Write a reminder on a ____. (Nota adhesiva/Post-it).", "options": ["sticky note", "folder", "clip", "shredder"], "correct_answer": "sticky note", "explanation": "Sticky note = nota adhesiva." },
        { "id": "a1-124-q11", "type": "quiz_choice", "question": "Can you ____ this document and email it to me? (Escanear).", "options": ["scan", "print", "shred", "copy"], "correct_answer": "scan", "explanation": "Scan = escanear (usando el scanner)." },
        { "id": "a1-124-q12", "type": "quiz_choice", "question": "The ____ is jammed. (Atascada - la impresora).", "options": ["printer", "folder", "clip", "staple"], "correct_answer": "printer", "explanation": "Printer is jammed = impresora atascada." },
        { "id": "a1-124-q13", "type": "quiz_choice", "question": "I need some office ____. (Suministros/Papelería).", "options": ["supplies", "equipments", "machines", "printers"], "correct_answer": "supplies", "explanation": "Office supplies (o stationery) = suministros de oficina." },
        { "id": "a1-124-q14", "type": "quiz_choice", "question": "Where is the hole ____? (Perforadora).", "options": ["punch", "stapler", "clip", "shredder"], "correct_answer": "punch", "explanation": "Hole punch = perforadora." },
        { "id": "a1-124-q15", "type": "quiz_choice", "question": "We are out of ink ____. (Cartuchos de tinta).", "options": ["cartridges", "papers", "staples", "clips"], "correct_answer": "cartridges", "explanation": "Ink cartridges = cartuchos de tinta." },
        { "id": "a1-124-q16", "type": "quiz_choice", "question": "Throw the trash in the ____. (Basurero).", "options": ["wastebasket", "shredder", "printer", "folder"], "correct_answer": "wastebasket", "explanation": "Wastebasket / Bin = papelera." },
        { "id": "a1-124-q17", "type": "quiz_choice", "question": "I need a white ____ to write on during the meeting. (Pizarra).", "options": ["whiteboard", "folder", "projector", "scanner"], "correct_answer": "whiteboard", "explanation": "Whiteboard = pizarra blanca." },
        { "id": "a1-124-q18", "type": "quiz_choice", "question": "Do you have a ____ drive? (Memoria USB).", "options": ["flash", "printer", "scanner", "shredder"], "correct_answer": "flash", "explanation": "Flash drive / USB drive = memoria USB." },
        { "id": "a1-124-q19", "type": "quiz_choice", "question": "My ____ is not working. I can't type. (Teclado).", "options": ["keyboard", "mouse", "monitor", "printer"], "correct_answer": "keyboard", "explanation": "Keyboard = teclado." },
        { "id": "a1-124-q20", "type": "quiz_choice", "question": "Look at the ____. (Pantalla).", "options": ["screen", "keyboard", "mouse", "printer"], "correct_answer": "screen", "explanation": "Screen / Monitor = pantalla." }
