      "questions": [
        { "id": "a1-150-q1", "type": "quiz_choice", "question": "I ____ the new HR manager. (Soy).", "options": ["am", "is", "are", "be"], "correct_answer": "am", "explanation": "Verbo To Be (I) = am." },
        { "id": "a1-150-q2", "type": "quiz_choice", "question": "She ____ emails every morning. (Revisa - Rutina).", "options": ["checks", "check", "checking", "is check"], "correct_answer": "checks", "explanation": "Present Simple (She) lleva 's' = checks." },
        { "id": "a1-150-q3", "type": "quiz_choice", "question": "____ you have the report? (¿Tienes...?).", "options": ["Do", "Does", "Are", "Is"], "correct_answer": "Do", "explanation": "Auxiliar para rutina (You) = Do." },
        { "id": "a1-150-q4", "type": "quiz_choice", "question": "I ____ working on the presentation right now. (Estoy).", "options": ["am", "was", "are", "have"], "correct_answer": "am", "explanation": "Present Continuous = am working." },
        { "id": "a1-150-q5", "type": "quiz_choice", "question": "We ____ the contract yesterday. (Firmamos).", "options": ["signed", "sign", "signing", "signs"], "correct_answer": "signed", "explanation": "Past Simple = signed." },
        { "id": "a1-150-q6", "type": "quiz_choice", "question": "____ she attend the meeting last week?", "options": ["Did", "Does", "Do", "Was"], "correct_answer": "Did", "explanation": "Auxiliar de Past Simple = Did." },
        { "id": "a1-150-q7", "type": "quiz_choice", "question": "I ____ talking to the client when you called. (Estaba).", "options": ["was", "were", "am", "did"], "correct_answer": "was", "explanation": "Past Continuous (I) = was." },
        { "id": "a1-150-q8", "type": "quiz_choice", "question": "I have ____ sent the email. (Acabo de).", "options": ["just", "already", "yet", "ever"], "correct_answer": "just", "explanation": "Present Perfect con acción muy reciente = just." },
        { "id": "a1-150-q9", "type": "quiz_choice", "question": "Have you ____ managed a team? (¿Alguna vez...?).", "options": ["ever", "never", "yet", "already"], "correct_answer": "ever", "explanation": "Pregunta de experiencia = ever." },
        { "id": "a1-150-q10", "type": "quiz_choice", "question": "You ____ wear a hard hat on the construction site. (Obligación).", "options": ["must", "can", "should", "would"], "correct_answer": "must", "explanation": "Obligación estricta = must." },
        { "id": "a1-150-q11", "type": "quiz_choice", "question": "I ____ like to request a meeting. (Deseo formal).", "options": ["would", "should", "can", "must"], "correct_answer": "would", "explanation": "Deseo formal = would like." },
        { "id": "a1-150-q12", "type": "quiz_choice", "question": "The meeting is ____ Monday.", "options": ["on", "in", "at", "to"], "correct_answer": "on", "explanation": "Días de la semana = on." },
        { "id": "a1-150-q13", "type": "quiz_choice", "question": "The manager is ____ the meeting room. (Adentro).", "options": ["in", "on", "at", "by"], "correct_answer": "in", "explanation": "Espacio cerrado = in." },
        { "id": "a1-150-q14", "type": "quiz_choice", "question": "Please find the report ____. (En el correo).", "options": ["attached", "subject", "forward", "reply"], "correct_answer": "attached", "explanation": "Find the report attached." },
        { "id": "a1-150-q15", "type": "quiz_choice", "question": "Hello, Sarah ____. (Contestando el teléfono).", "options": ["speaking", "talking", "calling", "saying"], "correct_answer": "speaking", "explanation": "Speaking = al habla." },
        { "id": "a1-150-q16", "type": "quiz_choice", "question": "Please ____ on a moment. (Espere en el teléfono).", "options": ["hold", "wait", "stay", "keep"], "correct_answer": "hold", "explanation": "Hold on = esperar." },
        { "id": "a1-150-q17", "type": "quiz_choice", "question": "We need to ____ a meeting. (Programar).", "options": ["schedule", "cancel", "attend", "forward"], "correct_answer": "schedule", "explanation": "Schedule = programar." },
        { "id": "a1-150-q18", "type": "quiz_choice", "question": "Did you read the ____? (Orden del día).", "options": ["agenda", "minutes", "subject", "attendees"], "correct_answer": "agenda", "explanation": "Agenda." },
        { "id": "a1-150-q19", "type": "quiz_choice", "question": "Can I ____ a message? (Tomar).", "options": ["take", "make", "leave", "give"], "correct_answer": "take", "explanation": "Take a message." },
        { "id": "a1-150-q20", "type": "quiz_choice", "question": "As you can see on the ____. (Diapositiva).", "options": ["slide", "page", "board", "presentation"], "correct_answer": "slide", "explanation": "Slide." }
