        { "id": "a1-87-q9", "type": "quiz_choice", "question": "I ____ the email. (forward).", "options": ["forwarded", "forward", "forwarding", "forwards"], "correct_answer": "forwarded", "explanation": "Forward + ed = forwarded." },
        { "id": "a1-87-q10", "type": "quiz_choice", "question": "He ____ the data. (analyze).", "options": ["analyzed", "analyze", "analyzing", "analyzes"], "correct_answer": "analyzed", "explanation": "Analyze + d = analyzed." },
        { "id": "a1-87-q11", "type": "quiz_choice", "question": "I ____ finish the report. (negativo).", "options": ["didn't", "wasn't", "don't", "am not"], "correct_answer": "didn't", "explanation": "Negativo pasado: didn't + infinitivo." },
        { "id": "a1-87-q12", "type": "quiz_choice", "question": "She ____ attend the meeting. (negativo).", "options": ["didn't", "wasn't", "doesn't", "can't"], "correct_answer": "didn't", "explanation": "Negativo pasado: didn't + infinitivo." },
        { "id": "a1-87-q13", "type": "quiz_choice", "question": "____ you send the email? (Pregunta).", "options": ["Did", "Was", "Do", "Have"], "correct_answer": "Did", "explanation": "Pregunta pasado: Did + sujeto + infinitivo?" },
        { "id": "a1-87-q14", "type": "quiz_choice", "question": "____ they complete the task? (Pregunta).", "options": ["Did", "Were", "Do", "Have"], "correct_answer": "Did", "explanation": "Did they?" },
        { "id": "a1-87-q15", "type": "quiz_choice", "question": "Yes, I ____. (Respuesta corta positiva).", "options": ["did", "was", "do", "have"], "correct_answer": "did", "explanation": "Yes, I did." },
        { "id": "a1-87-q16", "type": "quiz_choice", "question": "No, I ____. (Respuesta corta negativa).", "options": ["didn't", "wasn't", "don't", "can't"], "correct_answer": "didn't", "explanation": "No, I didn't." },
        { "id": "a1-87-q17", "type": "quiz_choice", "question": "We ____ the meeting. (cancel).", "options": ["cancelled", "cancel", "cancelling", "cancels"], "correct_answer": "cancelled", "explanation": "Cancel + led = cancelled." },
        { "id": "a1-87-q18", "type": "quiz_choice", "question": "I ____ in English. (study).", "options": ["studied", "study", "studying", "studies"], "correct_answer": "studied", "explanation": "Study -> studied (y -> ied)." },
        { "id": "a1-87-q19", "type": "quiz_choice", "question": "She ____ the invoice. (check).", "options": ["checked", "check", "checking", "checks"], "correct_answer": "checked", "explanation": "Check + ed = checked." },
