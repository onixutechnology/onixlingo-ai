    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Pasado Simple Regular",
      "parts": [
        { "visual": "Los verbos regulares en pasado añaden '-ed': Work -> Worked. Finish -> Finished. Talk -> Talked. Negativo: I didn't work (No trabajé). Pregunta: Did you work?", "audio": "Regular verbs in the past add -ed: Work becomes worked. Finish becomes finished. Talk becomes talked. Negative: I didn't work. Question: Did you work?" },
        { "visual": "Si el verbo termina en 'e', se agrega solo 'd': Decide -> Decided. Si termina en consonante + 'y', cambia a 'ied': Study -> Studied.", "audio": "If the verb ends in e, just add d: Decide becomes decided. If it ends in consonant plus y, change to ied: Study becomes studied." }
      ]
    },
    {
