      "questions": [
        { "id": "a1-87-q1", "type": "quiz_choice", "question": "I ____ the report yesterday. (finish).", "options": ["finished", "finish", "finishing", "finishes"], "correct_answer": "finished", "explanation": "Finish + ed = finished." },
        { "id": "a1-87-q2", "type": "quiz_choice", "question": "She ____ the client last Monday. (call).", "options": ["called", "call", "calling", "calls"], "correct_answer": "called", "explanation": "Call + ed = called." },
        { "id": "a1-87-q3", "type": "quiz_choice", "question": "We ____ the project on time. (complete).", "options": ["completed", "complete", "completing", "completes"], "correct_answer": "completed", "explanation": "Complete + d = completed." },
        { "id": "a1-87-q4", "type": "quiz_choice", "question": "He ____ to the manager. (talk).", "options": ["talked", "talk", "talking", "talks"], "correct_answer": "talked", "explanation": "Talk + ed = talked." },
        { "id": "a1-87-q5", "type": "quiz_choice", "question": "They ____ the contract. (sign).", "options": ["signed", "sign", "signing", "signs"], "correct_answer": "signed", "explanation": "Sign + ed = signed." },
        { "id": "a1-87-q6", "type": "quiz_choice", "question": "I ____ the proposal. (prepare).", "options": ["prepared", "prepare", "preparing", "prepares"], "correct_answer": "prepared", "explanation": "Prepare + d = prepared." },
        { "id": "a1-87-q7", "type": "quiz_choice", "question": "She ____ the budget. (review).", "options": ["reviewed", "review", "reviewing", "reviews"], "correct_answer": "reviewed", "explanation": "Review + ed = reviewed." },
