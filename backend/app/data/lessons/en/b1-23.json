    {
      "id": "stg_theory",
      "type": "lecture",
      "title": "Prefijos y Sufijos en los Negocios",
      "parts": [
        { "visual": "Prefijos comunes (al inicio): \n- Over- (Demasiado / En exceso): Overcharge (Cobrar de más), Overworked (Trabajar en exceso). \n- Under- (Por debajo de / Insuficiente): Underestimate (Subestimar), Underpaid (Mal pagado). \n- Pro- (A favor de / Antes): Proactive (Proactivo).", "audio": "Common prefixes. Over- means too much. For example, overcharge or overworked. Under- means not enough. For example, underestimate or underpaid. Pro- means before or in favor of, like proactive." },
        { "visual": "Sufijos comunes (al final): \n- -less (Sin): Useless (Inútil), Paperless (Sin papel). \n- -ful (Lleno de): Successful (Exitoso), Useful (Útil). \n- -ize / -ise (Convertir en): Modernize (Modernizar), Maximize (Maximizar).", "audio": "Common suffixes. -less means without, like useless or paperless. -ful means full of, like successful or useful. -ize or -ise means to make or become, like modernize or maximize." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la palabra correcta con el prefijo o sufijo adecuado.",
      "questions": [
        { "id": "b1-23-q1", "type": "quiz_choice", "question": "Never ____ your competitors. They might surprise you. (Subestimar).", "options": ["underestimate", "overestimate", "estimate", "proestimate"], "correct_answer": "underestimate", "explanation": "Under (por debajo) + estimate = underestimate (subestimar)." },
        { "id": "b1-23-q2", "type": "quiz_choice", "question": "The restaurant ____ us for the drinks. The bill was too high! (Nos cobró de más).", "options": ["overcharged", "undercharged", "charged", "recharged"], "correct_answer": "overcharged", "explanation": "Over (exceso) + charge (cobrar) = overcharge." },
        { "id": "b1-23-q3", "type": "quiz_choice", "question": "Many nurses feel ____ and underpaid. (Trabajan en exceso).", "options": ["overworked", "underworked", "worked", "working"], "correct_answer": "overworked", "explanation": "Overworked = trabajar demasiado." },
        { "id": "b1-23-q4", "type": "quiz_choice", "question": "The meeting was ____. We didn't decide anything. (Inútil / Sin uso).", "options": ["useless", "useful", "used", "use"], "correct_answer": "useless", "explanation": "Use + less (sin) = useless (inútil)." },
        { "id": "b1-23-q5", "type": "quiz_choice", "question": "The new marketing campaign was very ____. We sold out! (Exitosa).", "options": ["successful", "success", "successless", "succeed"], "correct_answer": "successful", "explanation": "Success + ful (lleno de) = successful (exitoso)." },
        { "id": "b1-23-q6", "type": "quiz_choice", "question": "We need to ____ our profit this year. (Maximizar).", "options": ["maximize", "maximum", "maxless", "overmax"], "correct_answer": "maximize", "explanation": "Sufijo -ize convierte palabras en verbos: maximize." },
        { "id": "b1-23-q7", "type": "quiz_choice", "question": "The company wants to become a ____ office to save trees. (Sin papel).", "options": ["paperless", "paperful", "unpaper", "repaper"], "correct_answer": "paperless", "explanation": "Paper + less (sin) = paperless." },
        { "id": "b1-23-q8", "type": "quiz_choice", "question": "She is a very ____ employee. She anticipates problems. (Proactiva).", "options": ["proactive", "reactive", "inactive", "overactive"], "correct_answer": "proactive", "explanation": "Proactive = el que actúa por adelantado." },
        { "id": "b1-23-q9", "type": "quiz_choice", "question": "We need to ____ the old factory. (Modernizar).", "options": ["modernize", "modern", "modernless", "modernful"], "correct_answer": "modernize", "explanation": "Modernize." },
        { "id": "b1-23-q10", "type": "quiz_choice", "question": "I think the project is ____. It will be very hard to finish on time. (Poco realista).", "options": ["unrealistic", "realistic", "inrealistic", "disrealistic"], "correct_answer": "unrealistic", "explanation": "Prefijo un- (negación) + realistic = unrealistic (poco realista)." },
        { "id": "b1-23-q11", "type": "quiz_choice", "question": "The employees are ____ with the new management. (Insatisfechos).", "options": ["dissatisfied", "unsatisfied", "satisfyless", "missatisfied"], "correct_answer": "dissatisfied", "explanation": "Dissatisfied = insatisfechos." },
        { "id": "b1-23-q12", "type": "quiz_choice", "question": "You must ____ your software to fix the bugs. (Actualizar).", "options": ["update", "downdate", "reupdate", "overdate"], "correct_answer": "update", "explanation": "Up (hacia arriba/al día) + date = update (actualizar)." },
        { "id": "b1-23-q13", "type": "quiz_choice", "question": "If you don't like the product, we can ____ your money. (Reembolsar).", "options": ["refund", "fund", "defund", "unfund"], "correct_answer": "refund", "explanation": "Re (de vuelta/otra vez) + fund = refund." },
        { "id": "b1-23-q14", "type": "quiz_choice", "question": "He was ____ because he didn't have the right skills. (No calificado / Sin calificaciones).", "options": ["unqualified", "disqualified", "misqualified", "overqualified"], "correct_answer": "unqualified", "explanation": "Unqualified = no calificado. Overqualified = sobrecalificado." },
        { "id": "b1-23-q15", "type": "quiz_choice", "question": "We need to ____ our expenses if we want to survive. (Minimizar).", "options": ["minimize", "minimum", "miniless", "minorize"], "correct_answer": "minimize", "explanation": "Minimize." },
        { "id": "b1-23-q16", "type": "quiz_choice", "question": "The instructions were completely ____. I didn't understand anything. (Inútiles / Poco útiles).", "options": ["unhelpful", "helpful", "helpless", "dishelpful"], "correct_answer": "unhelpful", "explanation": "Unhelpful = que no ayuda. Helpless = indefenso." },
        { "id": "b1-23-q17", "type": "quiz_choice", "question": "It's a ____ mistake. Don't worry about it. (Inofensivo / Sin daño).", "options": ["harmless", "harmful", "unharm", "disharm"], "correct_answer": "harmless", "explanation": "Harm (daño) + less = harmless (inofensivo)." },
        { "id": "b1-23-q18", "type": "quiz_choice", "question": "This software is very ____ for data analysis. (Poderoso).", "options": ["powerful", "powerless", "unpower", "repower"], "correct_answer": "powerful", "explanation": "Power + ful = powerful." },
        { "id": "b1-23-q19", "type": "quiz_choice", "question": "We ____ the importance of social media. (Subestimamos).", "options": ["underestimated", "overestimated", "estimated", "unestimated"], "correct_answer": "underestimated", "explanation": "Underestimated." },
        { "id": "b1-23-q20", "type": "quiz_choice", "question": "They ____ the meeting schedule without telling me. (Reorganizaron / Cambiaron).", "options": ["rearranged", "arranged", "unarranged", "disarranged"], "correct_answer": "rearranged", "explanation": "Re (volver a) + arrange = rearrange (reorganizar)." }
      ]
    },
