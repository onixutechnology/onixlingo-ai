      "parts": [
        { "visual": "Usa IN para meses, años y partes del día (in May, in 2023, in the morning).", "audio": "Use IN for months, years, and parts of the day." },
        { "visual": "Usa ON para días de la semana y fechas específicas (on Monday, on May 5th). Usa AT para la hora exacta (at 9 AM, at noon).", "audio": "Use ON for days and dates. Use AT for exact times." }
      ]
