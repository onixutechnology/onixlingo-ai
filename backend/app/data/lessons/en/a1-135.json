      "parts": [
        { "visual": "Al contestar: Hello, [Name] speaking (Hola, habla [Nombre]). Para preguntar quién llama: Who is calling, please? (¿Quién llama, por favor?).", "audio": "When answering the phone: Hello, John speaking. To ask who is calling: Who is calling, please?" },
        { "visual": "Para pedir que esperen: Hold on a moment, please (Espere un momento). Para conectar la llamada: I will put you through (Le comunicaré). Dejar mensaje: Can I leave a message? (¿Puedo dejar un mensaje?).", "audio": "To ask someone to wait: Hold on a moment, please. To connect the call: I will put you through. To leave a message: Can I leave a message?" }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la palabra o frase correcta para la llamada telefónica.",
      "questions": [
        { "id": "a1-135-q1", "type": "quiz_choice", "question": "Hello, Marketing department. Sarah ____. (Hablando).", "options": ["speaking", "talking", "saying", "telling"], "correct_answer": "speaking", "explanation": "Al teléfono se dice '[Nombre] speaking'." },
        { "id": "a1-135-q2", "type": "quiz_choice", "question": "Hello, is Mr. Davis ____? (¿Está ahí/disponible?).", "options": ["there", "here", "in", "at"], "correct_answer": "there", "explanation": "Is [persona] there? = ¿Se encuentra / está ahí?" },
        { "id": "a1-135-q3", "type": "quiz_choice", "question": "____ is calling, please? (¿Quién?).", "options": ["Who", "What", "How", "Why"], "correct_answer": "Who", "explanation": "Who is calling = Quién llama." },
        { "id": "a1-135-q4", "type": "quiz_choice", "question": "Please ____ on a moment. (Espere en la línea).", "options": ["hold", "wait", "stay", "keep"], "correct_answer": "hold", "explanation": "Hold on = esperar al teléfono." },
        { "id": "a1-135-q5", "type": "quiz_choice", "question": "I will put you ____. (Le comunicaré/pasaré la llamada).", "options": ["through", "in", "on", "out"], "correct_answer": "through", "explanation": "Put someone through = comunicar/pasar la llamada." },
        { "id": "a1-135-q6", "type": "quiz_choice", "question": "I'm sorry, he is not ____ right now. (Disponible).", "options": ["available", "free", "there", "open"], "correct_answer": "available", "explanation": "He is not available = No está disponible." },
        { "id": "a1-135-q7", "type": "quiz_choice", "question": "Can I take a ____? (Mensaje).", "options": ["message", "note", "letter", "word"], "correct_answer": "message", "explanation": "Take a message = Tomar un mensaje." },
        { "id": "a1-135-q8", "type": "quiz_choice", "question": "Yes, can I ____ a message? (Dejar).", "options": ["leave", "give", "put", "take"], "correct_answer": "leave", "explanation": "Leave a message = Dejar un mensaje." },
        { "id": "a1-135-q9", "type": "quiz_choice", "question": "Could you ask him to ____ me back? (Devolverme la llamada).", "options": ["call", "speak", "phone", "ring"], "correct_answer": "call", "explanation": "Call me back = Devolverme la llamada." },
        { "id": "a1-135-q10", "type": "quiz_choice", "question": "Can you speak ____, please? (Más alto).", "options": ["up", "out", "more", "high"], "correct_answer": "up", "explanation": "Speak up = hablar más fuerte/alto." },
        { "id": "a1-135-q11", "type": "quiz_choice", "question": "I'm sorry, you have the ____ number. (Equivocado).", "options": ["wrong", "bad", "false", "incorrect"], "correct_answer": "wrong", "explanation": "Wrong number = número equivocado." },
        { "id": "a1-135-q12", "type": "quiz_choice", "question": "Hello, this ____ David from IT. (Soy).", "options": ["is", "am", "are", "be"], "correct_answer": "is", "explanation": "Al presentarse por teléfono se dice 'This is [nombre]', no 'I am'." },
        { "id": "a1-135-q13", "type": "quiz_choice", "question": "I can't ____ you very well. The signal is bad. (Escuchar).", "options": ["hear", "listen", "understand", "sound"], "correct_answer": "hear", "explanation": "Hear = oír/escuchar el sonido físico." },
        { "id": "a1-135-q14", "type": "quiz_choice", "question": "We got ____ off. (Se cortó la llamada).", "options": ["cut", "put", "taken", "let"], "correct_answer": "cut", "explanation": "Cut off = cortarse la línea." },
        { "id": "a1-135-q15", "type": "quiz_choice", "question": "Could you ____ that, please? (Repetir).", "options": ["repeat", "say", "speak", "tell"], "correct_answer": "repeat", "explanation": "Repeat = repetir." },
        { "id": "a1-135-q16", "type": "quiz_choice", "question": "Could you ____ your name, please? (Deletrear).", "options": ["spell", "write", "say", "read"], "correct_answer": "spell", "explanation": "Spell = deletrear." },
        { "id": "a1-135-q17", "type": "quiz_choice", "question": "Hold the ____, please. (Línea).", "options": ["line", "phone", "call", "wire"], "correct_answer": "line", "explanation": "Hold the line = manténgase en la línea." },
        { "id": "a1-135-q18", "type": "quiz_choice", "question": "I'll make sure he ____ the message. (Reciba).", "options": ["gets", "has", "takes", "makes"], "correct_answer": "gets", "explanation": "Get the message = recibir el mensaje." },
        { "id": "a1-135-q19", "type": "quiz_choice", "question": "Thanks for ____. Goodbye. (Llamar).", "options": ["calling", "call", "to call", "called"], "correct_answer": "calling", "explanation": "For + verbo-ing = por llamar." },
        { "id": "a1-135-q20", "type": "quiz_choice", "question": "I am returning his ____. (Llamada).", "options": ["call", "calling", "phone", "message"], "correct_answer": "call", "explanation": "Return a call = devolver una llamada." }
      ]
    },
