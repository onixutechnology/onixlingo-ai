      "id": "stg_theory",
      "type": "lecture",
      "title": "Concepto Teórico: Should / Shouldn't",
      "parts": [
        { "visual": "Should = debería (consejo/recomendación). You should arrive on time (Deberías llegar a tiempo). We should review the contract (Deberíamos revisar el contrato). Shouldn't = no deberías. You shouldn't be late (No deberías llegar tarde).", "audio": "Should means should, for advice and recommendations. You should arrive on time. We should review the contract. Shouldn't means should not. You shouldn't be late." },
        { "visual": "Estructura: Sujeto + should + infinitivo (sin to). I should call the client. He should NOT = shouldn't update the file. Pregunta: Should I send the email? (¿Debería enviar el email?). La misma forma para todas las personas: I/You/He/She/We/They should.", "audio": "Structure: Subject plus should plus bare infinitive. I should call the client. Negative: shouldn't. Question: Should I send the email? Same form for all persons." }
      ]
    },
    {
      "id": "stg_quiz_choice",
      "type": "quiz_choice",
      "title": "Interactive Quiz",
      "description": "Elige la forma correcta con 'should' o 'shouldn't'.",
      "questions": [
        { "id": "a1-111-q1", "type": "quiz_choice", "question": "You ____ arrive on time. (Deberías).", "options": ["should", "shouldn't", "must", "can"], "correct_answer": "should", "explanation": "Should = deberías." },
        { "id": "a1-111-q2", "type": "quiz_choice", "question": "You ____ be late to meetings. (No deberías).", "options": ["shouldn't", "should", "mustn't", "can't"], "correct_answer": "shouldn't", "explanation": "Shouldn't = no deberías." },
        { "id": "a1-111-q3", "type": "quiz_choice", "question": "We ____ review the contract before signing. (Deberíamos).", "options": ["should", "shouldn't", "will", "must"], "correct_answer": "should", "explanation": "Should = deberíamos." },
        { "id": "a1-111-q4", "type": "quiz_choice", "question": "He should ____ the client. (Llamar).", "options": ["call", "calls", "calling", "called"], "correct_answer": "call", "explanation": "Should + bare infinitive: call." },
        { "id": "a1-111-q5", "type": "quiz_choice", "question": "She ____ share confidential data. (No debería).", "options": ["shouldn't", "should", "mustn't", "won't"], "correct_answer": "shouldn't", "explanation": "Shouldn't = no debería." },
        { "id": "a1-111-q6", "type": "quiz_choice", "question": "____ I send the report now? (¿Debería?).", "options": ["Should", "Must", "Do", "Will"], "correct_answer": "Should", "explanation": "Should I...? = ¿Debería...?" },
        { "id": "a1-111-q7", "type": "quiz_choice", "question": "Yes, you ____. (Respuesta corta positiva).", "options": ["should", "shouldn't", "do", "will"], "correct_answer": "should", "explanation": "Yes, you should." },
        { "id": "a1-111-q8", "type": "quiz_choice", "question": "No, you ____. (Respuesta corta negativa).", "options": ["shouldn't", "should", "don't", "won't"], "correct_answer": "shouldn't", "explanation": "No, you shouldn't." },
        { "id": "a1-111-q9", "type": "quiz_choice", "question": "We ____ prepare an agenda before the meeting. (Deberíamos).", "options": ["should", "shouldn't", "must", "can"], "correct_answer": "should", "explanation": "Should = deberíamos." },
        { "id": "a1-111-q10", "type": "quiz_choice", "question": "You ____ use your phone in meetings. (No deberías).", "options": ["shouldn't", "should", "can't", "mustn't"], "correct_answer": "shouldn't", "explanation": "Shouldn't = no deberías." },
        { "id": "a1-111-q11", "type": "quiz_choice", "question": "I think we ____ hire more staff. (Deberíamos).", "options": ["should", "shouldn't", "will", "might"], "correct_answer": "should", "explanation": "Should = deberíamos (opinión)." },
        { "id": "a1-111-q12", "type": "quiz_choice", "question": "You ____ send that email. It is too aggressive. (No deberías).", "options": ["shouldn't", "should", "mustn't", "can't"], "correct_answer": "shouldn't", "explanation": "Shouldn't = no deberías." },
        { "id": "a1-111-q13", "type": "quiz_choice", "question": "He ____ ask his manager first. (Debería).", "options": ["should", "shouldn't", "must", "will"], "correct_answer": "should", "explanation": "Should = debería." },
        { "id": "a1-111-q14", "type": "quiz_choice", "question": "The team ____ take a break. (Debería).", "options": ["should", "shouldn't", "must", "can"], "correct_answer": "should", "explanation": "Should = debería." },
        { "id": "a1-111-q15", "type": "quiz_choice", "question": "We ____ ignore the client's feedback. (No deberíamos).", "options": ["shouldn't", "should", "mustn't", "won't"], "correct_answer": "shouldn't", "explanation": "Shouldn't = no deberíamos." },
        { "id": "a1-111-q16", "type": "quiz_choice", "question": "Should we ____ the deadline? (Extend - Alargar).", "options": ["extend", "extends", "extending", "extended"], "correct_answer": "extend", "explanation": "Should + bare infinitive: extend." },
        { "id": "a1-111-q17", "type": "quiz_choice", "question": "I ____ think we need a new strategy. (Creo que deberíamos).", "options": ["think we should", "think we will", "think we must", "think we can"], "correct_answer": "think we should", "explanation": "I think we should = creo que deberíamos." },
        { "id": "a1-111-q18", "type": "quiz_choice", "question": "You ____ worry. Everything is fine. (No deberías).", "options": ["shouldn't", "should", "mustn't", "won't"], "correct_answer": "shouldn't", "explanation": "Shouldn't worry = no deberías preocuparte." },
        { "id": "a1-111-q19", "type": "quiz_choice", "question": "She ____ follow up on the proposal. (Debería).", "options": ["should", "shouldn't", "must", "will"], "correct_answer": "should", "explanation": "Should = debería." },
        { "id": "a1-111-q20", "type": "quiz_choice", "question": "____ we accept their offer? (¿Deberíamos?).", "options": ["Should", "Must", "Do", "Will"], "correct_answer": "Should", "explanation": "Should we...? = ¿Deberíamos...?" }
      ]
    },
